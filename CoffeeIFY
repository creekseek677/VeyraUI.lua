		Font = Visual.FontBold,
		TextSize = 12,
		Visible = false,
		ZIndex = 100,
		Parent = root,
	})

	function w:_ShowCursor(target)
		if self._closing or not self._cursor or not target or not target.Parent then return end
		local mainAbs = root.AbsolutePosition
		local tAbs = target.AbsolutePosition
		local tSize = target.AbsoluteSize
		local x = (tAbs.X - mainAbs.X) - 12
		local y = (tAbs.Y - mainAbs.Y) + (tSize.Y / 2) - 7
		self._cursor.Visible = true
		self._cursor.TextTransparency = 0
		Anim.tween(self._cursor, 0.12, { Position = UDim2.fromOffset(x, y) })
	end

	function w:_HideCursor()
		if not self._cursor then return end
		Anim.tween(self._cursor, 0.1, { TextTransparency = 1 })
		task.delay(0.1, function()
			if self._cursor and self._cursor.TextTransparency >= 0.9 then
				self._cursor.Visible = false
			end
		end)
	end

	-- internal "CoffeeIFY" info tab
	task.spawn(function()
		local infoTab = w:CreateTab({ Name = "CoffeeIFY", Icon = "info" })
		local about = infoTab:CreateSection("About")

		local displayName = "Player"
		local userName = "Player"
		local userId = 0
