-- ===================== DROPDOWN =====================
-- theme support: pass a theme table as 6th arg
function CoffeeIFY:CreateDropdown(tab, text, options, default, callback, theme)
	local page = typeof(tab) == "table" and tab.Page or self.tabs[tab].Page
	options = options or {"Option 1", "Option 2", "Option 3"}
	local selected = default or options[1]
	local open = false

	-- theme defaults (coffee style)
	theme = theme or {}
	local t = {
		Bg = theme.Bg or Color3.fromRGB(218, 208, 188),
		ListBg = theme.ListBg or Color3.fromRGB(210, 200, 180),
		Hover = theme.Hover or Color3.fromRGB(200, 190, 170),
		Text = theme.Text or Color3.fromRGB(40, 35, 30),
		SelectedText = theme.SelectedText or Color3.fromRGB(80, 70, 60),
		Stroke = theme.Stroke or Color3.fromRGB(170, 160, 140),
		Arrow = theme.Arrow or Color3.fromRGB(60, 55, 50),
	}

	local frame = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = t.Bg,
		BorderSizePixel = 0,
		ClipsDescendants = false,
		Parent = page
	})

	local mainBtn = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = t.Bg,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = frame
	})

	Create("TextLabel", {
		Text = text or "Dropdown",
		Size = UDim2.new(0.55, 0, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		TextColor3 = t.Text,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = mainBtn
	})

	local selectedLabel = Create("TextLabel", {
		Name = "Selected",
		Text = selected,
		Size = UDim2.new(0.4, -10, 1, 0),
		Position = UDim2.new(0.55, 0, 0, 0),
		BackgroundTransparency = 1,
		TextColor3 = t.SelectedText,
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = mainBtn
	})

	local arrow = Create("TextLabel", {
		Text = "▾",
		Size = UDim2.new(0, 16, 1, 0),
		Position = UDim2.new(1, -18, 0, 0),
		BackgroundTransparency = 1,
		TextColor3 = t.Arrow,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		Parent = mainBtn
	})

	local list = Create("Frame", {
		Name = "List",
		Size = UDim2.new(1, 0, 0, 0),
		Position = UDim2.new(0, 0, 0, 26),
		BackgroundColor3 = t.ListBg,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 20,
		Parent = frame
	})

	Create("UIStroke", {
		Color = t.Stroke,
		Thickness = 1,
		Parent = list
	})

	Create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 1),
		Parent = list
	})

	local function closeDropdown()
		open = false
		Tween(list, {Size = UDim2.new(1, 0, 0, 0)}, 0.2)
		arrow.Text = "▾"
		task.delay(0.2, function()
			if not open then
				list.Visible = false
			end
		end)
	end

	local function openDropdown()
		open = true
		list.Visible = true
		local height = #options * 24
		Tween(list, {Size = UDim2.new(1, 0, 0, height)}, 0.22, Enum.EasingStyle.Quad)
		arrow.Text = "▴"
		PlaySound(CLICK_SOUND, 0.3)
	end

	for _, opt in ipairs(options) do
		local optBtn = Create("TextButton", {
			Size = UDim2.new(1, 0, 0, 23),
			BackgroundColor3 = t.Bg,
			BorderSizePixel = 0,
			Text = "  " .. opt,
			TextColor3 = t.Text,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			ZIndex = 21,
			Parent = list
		})

		optBtn.MouseEnter:Connect(function()
			PlaySound(HOVER_SOUND, 0.18)
			optBtn.BackgroundColor3 = t.Hover
		end)
		optBtn.MouseLeave:Connect(function()
			optBtn.BackgroundColor3 = t.Bg
		end)

		local function pick()
			PlaySound(CLICK_SOUND, 0.4)
			selected = opt
			selectedLabel.Text = selected
			closeDropdown()
			if callback then
				callback(selected)
			end
		end

		optBtn.MouseButton1Click:Connect(pick)
		optBtn.TouchTap:Connect(pick)
	end

	local function toggle()
		if open then
			closeDropdown()
		else
			openDropdown()
		end
	end

	mainBtn.MouseEnter:Connect(function()
		PlaySound(HOVER_SOUND, 0.2)
		Tween(mainBtn, {BackgroundColor3 = t.Hover}, 0.15)
	end)
	mainBtn.MouseLeave:Connect(function()
		Tween(mainBtn, {BackgroundColor3 = t.Bg}, 0.15)
	end)
	mainBtn.MouseButton1Click:Connect(function()
		Tween(mainBtn, {BackgroundColor3 = Color3.fromRGB(190, 180, 160)}, 0.08)
		task.delay(0.1, function()
			Tween(mainBtn, {BackgroundColor3 = t.Bg}, 0.15)
		end)
		toggle()
	end)
	mainBtn.TouchTap:Connect(function()
		Tween(mainBtn, {BackgroundColor3 = Color3.fromRGB(190, 180, 160)}, 0.08)
		task.delay(0.1, function()
			Tween(mainBtn, {BackgroundColor3 = t.Bg}, 0.15)
		end)
		toggle()
	end)

	-- close when clicking/tapping elsewhere
	UserInputService.InputBegan:Connect(function(input)
		if not open then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local pos = input.Position
			local absPos = list.AbsolutePosition
			local absSize = list.AbsoluteSize
			if pos.X < absPos.X or pos.X > absPos.X + absSize.X or
			   pos.Y < absPos.Y - 26 or pos.Y > absPos.Y + absSize.Y then
				closeDropdown()
			end
		end
	end)

	return frame
end

-- ===================== KEYBIND =====================
function CoffeeIFY:CreateKeybind(tab, text, default, callback)
	local page = typeof(tab) == "table" and tab.Page or self.tabs[tab].Page
	local key = default or Enum.KeyCode.E
	local listening = false

	local frame = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Color3.fromRGB(218, 208, 188),
		BorderSizePixel = 0,
		Parent = page
	})

	Create("TextLabel", {
		Text = text or "Keybind",
		Size = UDim2.new(0.6, 0, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(40, 35, 30),
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame
	})

	local keyLabel = Create("TextLabel", {
		Name = "Key",
		Text = typeof(key) == "EnumItem" and key.Name or tostring(key),
		Size = UDim2.new(0.35, -10, 0, 18),
		Position = UDim2.new(0.65, 0, 0.5, -9),
		BackgroundColor3 = Color3.fromRGB(50, 45, 40),
		BorderSizePixel = 0,
		TextColor3 = Color3.fromRGB(230, 220, 200),
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		Parent = frame
	})

	local btn = Create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		Parent = frame
	})

	local function setKey(newKey)
		key = newKey
		keyLabel.Text = typeof(key) == "EnumItem" and key.Name or tostring(key)
		listening = false
		Tween(keyLabel, {BackgroundColor3 = Color3.fromRGB(50, 45, 40), TextColor3 = Color3.fromRGB(230, 220, 200)}, 0.2)
		Tween(frame, {BackgroundColor3 = Color3.fromRGB(218, 208, 188)}, 0.2)
		PlaySound(CLICK_SOUND, 0.35)
	end

	local function startListen()
		if listening then return end
		PlaySound(HOVER_SOUND, 0.25)
		listening = true
		keyLabel.Text = "..."
		Tween(keyLabel, {BackgroundColor3 = Color3.fromRGB(80, 70, 55), TextColor3 = Color3.fromRGB(255, 240, 200)}, 0.18)
		Tween(frame, {BackgroundColor3 = Color3.fromRGB(230, 220, 200)}, 0.15)
	end

	btn.MouseEnter:Connect(function()
		PlaySound(HOVER_SOUND, 0.2)
		Tween(frame, {BackgroundColor3 = Color3.fromRGB(230, 220, 200)}, 0.15)
		Tween(keyLabel, {Size = UDim2.new(0.35, -8, 0, 19)}, 0.12)
	end)
	btn.MouseLeave:Connect(function()
		if not listening then
			Tween(frame, {BackgroundColor3 = Color3.fromRGB(218, 208, 188)}, 0.15)
			Tween(keyLabel, {Size = UDim2.new(0.35, -10, 0, 18)}, 0.12)
		end
	end)
	btn.MouseButton1Click:Connect(startListen)
	btn.TouchTap:Connect(startListen)

	UserInputService.InputBegan:Connect(function(input, gp)
		-- fire callback when bound key is pressed
		if not listening then
			if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key then
				if callback then
					callback(key)
				end
			end
			return
		end

		-- listening mode
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if input.KeyCode == Enum.KeyCode.Escape then
				listening = false
				keyLabel.Text = typeof(key) == "EnumItem" and key.Name or tostring(key)
				keyLabel.BackgroundColor3 = Color3.fromRGB(50, 45, 40)
				keyLabel.TextColor3 = Color3.fromRGB(230, 220, 200)
			else
				setKey(input.KeyCode)
			end
		elseif input.UserInputType == Enum.UserInputType.Touch then
			-- touch support: cancel listening on touch (mobile friendly)
			listening = false
			keyLabel.Text = typeof(key) == "EnumItem" and key.Name or tostring(key)
			keyLabel.BackgroundColor3 = Color3.fromRGB(50, 45, 40)
			keyLabel.TextColor3 = Color3.fromRGB(230, 220, 200)
			PlaySound(CLICK_SOUND, 0.3)
		end
	end)

	return frame, function() return key end
end

return CoffeeIFY
