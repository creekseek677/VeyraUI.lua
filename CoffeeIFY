function CoffeeIFY:CreateButton(tab, text, callback)
	local page = typeof(tab) == "table" and tab.Page or self.tabs[tab].Page

	local frame = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Color3.fromRGB(218, 208, 188),
		BorderSizePixel = 0,
		Parent = page
	})

	local box = Create("Frame", {
		Size = UDim2.new(0, 12, 0, 12),
		Position = UDim2.new(0, 8, 0.5, -6),
		BackgroundColor3 = Color3.fromRGB(40, 35, 30),
		BorderSizePixel = 0,
		Parent = frame
	})

	Create("TextLabel", {
		Text = text or "Button",
		Size = UDim2.new(1, -30, 1, 0),
		Position = UDim2.new(0, 26, 0, 0),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(40, 35, 30),
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame
	})

	local btn = Create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		Parent = frame
	})

	btn.MouseEnter:Connect(function()
		PlaySound(HOVER_SOUND, 0.22)
		Tween(frame, {BackgroundColor3 = Color3.fromRGB(230, 220, 200)}, 0.15)
		Tween(box, {Size = UDim2.new(0, 13, 0, 13), Position = UDim2.new(0, 7.5, 0.5, -6.5)}, 0.15)
	end)
	btn.MouseLeave:Connect(function()
		Tween(frame, {BackgroundColor3 = Color3.fromRGB(218, 208, 188)}, 0.15)
		Tween(box, {Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0, 8, 0.5, -6)}, 0.15)
	end)

	local function onClick()
		PlaySound(CLICK_SOUND, 0.4)
		Tween(frame, {BackgroundColor3 = Color3.fromRGB(200, 190, 170)}, 0.08)
		Tween(box, {BackgroundColor3 = Color3.fromRGB(180, 160, 130), Size = UDim2.new(0, 11, 0, 11)}, 0.08)
		task.delay(0.12, function()
			Tween(frame, {BackgroundColor3 = Color3.fromRGB(218, 208, 188)}, 0.18)
			Tween(box, {BackgroundColor3 = Color3.fromRGB(40, 35, 30), Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0, 8, 0.5, -6)}, 0.18)
		end)
		if callback then
			callback()
		end
	end

	btn.MouseButton1Click:Connect(onClick)
	btn.TouchTap:Connect(onClick)

	return frame
end

function CoffeeIFY:CreateToggle(tab, text, default, callback)
	local page = typeof(tab) == "table" and tab.Page or self.tabs[tab].Page
	local state = default or false

	local frame = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Color3.fromRGB(218, 208, 188),
		BorderSizePixel = 0,
		Parent = page
	})

	local box = Create("Frame", {
		Size = UDim2.new(0, 12, 0, 12),
		Position = UDim2.new(0, 8, 0.5, -6),
		BackgroundColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 35, 30),
		BorderSizePixel = 0,
		Parent = frame
	})

	Create("TextLabel", {
		Text = text or "Toggle",
		Size = UDim2.new(1, -30, 1, 0),
		Position = UDim2.new(0, 26, 0, 0),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(40, 35, 30),
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame
	})

	local btn = Create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		Parent = frame
	})

	btn.MouseEnter:Connect(function()
		PlaySound(HOVER_SOUND, 0.22)
		Tween(frame, {BackgroundColor3 = Color3.fromRGB(230, 220, 200)}, 0.15)
		Tween(box, {Size = UDim2.new(0, 13, 0, 13), Position = UDim2.new(0, 7.5, 0.5, -6.5)}, 0.15)
	end)
	btn.MouseLeave:Connect(function()
		Tween(frame, {BackgroundColor3 = Color3.fromRGB(218, 208, 188)}, 0.15)
		Tween(box, {Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0, 8, 0.5, -6)}, 0.15)
	end)

	local function onToggle()
		PlaySound(CLICK_SOUND, 0.4)
		state = not state
		Tween(frame, {BackgroundColor3 = Color3.fromRGB(200, 190, 170)}, 0.08)
		Tween(box, {
			BackgroundColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 35, 30),
			Size = UDim2.new(0, 11, 0, 11)
		}, 0.12)
		task.delay(0.12, function()
			Tween(frame, {BackgroundColor3 = Color3.fromRGB(218, 208, 188)}, 0.18)
			Tween(box, {Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0, 8, 0.5, -6)}, 0.18)
		end)
		if callback then
			callback(state)
		end
	end

	btn.MouseButton1Click:Connect(onToggle)
	btn.TouchTap:Connect(onToggle)

	return frame
end

