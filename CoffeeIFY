-- Toggle (square + ON/OFF, black invade locks while ON)
function Section:CreateToggle(opts)
	opts = opts or {}
	local default = (opts.Default == true)
	local comp = setmetatable({ Value = default }, ComponentBase)
	local hovering = false

	local root = new("TextButton", {
		Name = "Toggle",
		BackgroundColor3 = Theme.Control,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 26),
		AutoButtonColor = false,
		Text = "",
		ClipsDescendants = true,
	})
	applyStroke(root, 1)
	root.Parent = self._list

	local overlay = new("Frame", {
		Name = "Hover",
		BackgroundColor3 = Theme.Dark,
		BorderSizePixel = 0,
		Size = default and UDim2.fromScale(1, 1) or UDim2.fromScale(0, 1),
		ZIndex = root.ZIndex + 1,
	})
	overlay.Parent = root

	-- fixed square (beige when on, dark when off)
	local box = new("Frame", {
		Name = "Box",
		BackgroundColor3 = default and Theme.Beige or Theme.Dark,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(12, 12),
		Position = UDim2.fromOffset(8, 7),
		ZIndex = root.ZIndex + 3,
	})
	box.Parent = root

	local label = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = tostring(opts.Name or "Toggle"),
		Font = Visual.Font,
		TextSize = Visual.TextSize,
		TextColor3 = default and Theme.White or Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -70, 1, 0),
		Position = UDim2.fromOffset(26, 0),
		ZIndex = root.ZIndex + 3,
	})
	label.Parent = root

	local status = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = default and "ON" or "OFF",
		Font = Visual.FontBold,
		TextSize = 11,
		TextColor3 = default and Theme.White or Theme.MutedText,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.fromOffset(36, 26),
		Position = UDim2.new(1, -42, 0, 0),
		ZIndex = root.ZIndex + 3,
	})
	status.Parent = root

	local function refreshVisual()
		local dark = comp.Value or hovering
		Anim.tween(overlay, 0.16, {
			Size = dark and UDim2.fromScale(1, 1) or UDim2.fromScale(0, 1)
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		Anim.tween(box, 0.14, {
			BackgroundColor3 = dark and Theme.Beige or Theme.Dark
		})
		Anim.tween(label, 0.14, {
			TextColor3 = dark and Theme.White or Theme.Text
		})
		status.Text = comp.Value and "ON" or "OFF"
		Anim.tween(status, 0.14, {
			TextColor3 = dark and Theme.White or Theme.MutedText
		})
	end

	root.MouseEnter:Connect(function()
		hovering = true
		PlaySound(HOVER_SOUND, 0.2)
		refreshVisual()
		if self.Tab.Window._ShowCursor then
			self.Tab.Window:_ShowCursor(root)
		end
	end)
	root.MouseLeave:Connect(function()
		hovering = false
		refreshVisual()
		if self.Tab.Window._HideCursor then
			self.Tab.Window:_HideCursor()
		end
	end)

	local function setValue(v: boolean, fire: boolean)
		v = v == true
		comp.Value = v
		refreshVisual()
		if fire then
			PlaySound(CLICK_SOUND, 0.35)
			safeCallback(opts.Callback, v)
		end
	end

	root.MouseButton1Click:Connect(function()
		if self.Tab.Window._interactive == false then return end
		setValue(not comp.Value, true)
	end)

	comp._root = root
	comp.SetValue = function(_, v) setValue(v, false) end

	table.insert(self.Components, comp)
	return comp
end

-- Slider
function Section:CreateSlider(opts)
	opts = opts or {}
	local minV = tonumber(opts.Min or 0) or 0
	local maxV = tonumber(opts.Max or 100) or 100
	if maxV < minV then
		minV, maxV = maxV, minV
	end
	local inc = tonumber(opts.Increment) or nil
	local default = tonumber(opts.Default)
	if default == nil then default = minV end
	default = clamp(default, minV, maxV)
	default = roundToIncrement(default, inc)

	local comp = setmetatable({ Value = default }, ComponentBase)
	local dragging = false

	local root = new("Frame", {
		Name = "Slider",
		BackgroundColor3 = Theme.Control,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 36),
	})
	applyCorner(root, 3)
	applyStroke(root, 1)
	root.Parent = self._list

	local btn = new("TextButton", {
		Name = "Hit",
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.fromScale(1, 1),
		AutoButtonColor = false,
	})
	btn.Parent = root

	local overlay = new("Frame", {
		Name = "Hover",
		BackgroundColor3 = Theme.Dark,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		ZIndex = root.ZIndex + 1,
	})
	applyCorner(overlay, 3)
	overlay.Parent = root

	local label = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = tostring(opts.Name or "Slider"),
		Font = Visual.FontBold,
		TextSize = Visual.TextSize,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -70, 0, 16),
		Position = UDim2.fromOffset(10, 2),
		ZIndex = root.ZIndex + 2,
	})
	label.Parent = root
	local labelDark = label:Clone()
	labelDark.TextColor3 = Theme.White
	labelDark.ZIndex = overlay.ZIndex + 2
	labelDark.Parent = overlay

	local valueLbl = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = tostring(default),
		Font = Visual.FontBold,
		TextSize = Visual.TextSize,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(0, 56, 0, 16),
		Position = UDim2.new(1, -66, 0, 2),
		ZIndex = root.ZIndex + 2,
	})
	valueLbl.Parent = root
	local valueLblDark = valueLbl:Clone()
	valueLblDark.TextColor3 = Theme.White
	valueLblDark.ZIndex = overlay.ZIndex + 2
	valueLblDark.Parent = overlay

	local bar = new("Frame", {
		Name = "Bar",
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -20, 0, 10),
		Position = UDim2.fromOffset(10, 22),
		ZIndex = root.ZIndex + 2,
	})
	applyCorner(bar, 3)
	applyStroke(bar, 1)
	bar.Parent = root

	local fill = new("Frame", {
		Name = "Fill",
		BackgroundColor3 = Theme.Dark,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		ZIndex = bar.ZIndex + 1,
	})
	applyCorner(fill, 3)
	fill.Parent = bar

	Anim.bindHoverInvasion(btn, overlay, { time = 0.14 })

	local function render(v: number, instant: boolean?)
		local alpha = if maxV == minV then 0 else (v - minV) / (maxV - minV)
		alpha = clamp(alpha, 0, 1)
		valueLbl.Text = tostring(v)
		valueLblDark.Text = valueLbl.Text
		if instant then
			fill.Size = UDim2.fromScale(alpha, 1)
		else
			Anim.tween(fill, 0.10, { Size = UDim2.fromScale(alpha, 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end

	local function setValue(v: number, fire: boolean)
		v = clamp(v, minV, maxV)
		v = roundToIncrement(v, inc)
		if comp.Value == v then
			render(v, false)
			return
		end
		comp.Value = v
		render(v, false)
		if fire then
			safeCallback(opts.Callback, v)
		end
	end

	render(default, true)

	local function positionToValue(x: number)
		local absPos = bar.AbsolutePosition.X
		local absSize = bar.AbsoluteSize.X
		local alpha = if absSize <= 0 then 0 else (x - absPos) / absSize
		alpha = clamp(alpha, 0, 1)
		return minV + (maxV - minV) * alpha
	end

	btn.InputBegan:Connect(function(input)
		if self.Tab.Window._interactive == false then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setValue(positionToValue(input.Position.X), true)
		end
	end)
	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	local moveConn
	moveConn = UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			setValue(positionToValue(input.Position.X), true)
		end
	end)
	table.insert(self.Tab.Window._connections, moveConn)

	comp._root = root
	comp.SetValue = function(_, v) setValue(tonumber(v) or minV, false) end

	table.insert(self.Components, comp)
	return comp
end

