            function sec:AddSlider(o)
                o = o or {}
                local text = o.Text or o.Name or "Slider"
                local min  = o.Min or 0
                local max  = o.Max or 100
                local def  = o.Default or min
                local inc  = o.Increment or 1
                local suf  = o.Suffix or ""
                local show = o.ShowValue ~= false
                local cb   = o.Callback or function() end
                local val  = def

                local r = Make("Frame", {
                    BackgroundColor3 = C.Row, BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 26), LayoutOrder = #sec.Elements + 1, Parent = holder
                })
                Border(r, C.Border, 1)
