                })

                local track = Make("Frame", {
                    BackgroundColor3 = C.SliderTrack, BorderSizePixel = 0,
                    Size = UDim2.new(0, 150, 0, 3), Position = UDim2.new(1, -200, 0.5, -1.5), Parent = r
                })
                Border(track, C.NearBlack, 1)

                local fill = Make("Frame", {
                    BackgroundColor3 = C.SliderFill, BorderSizePixel = 0,
                    Size = UDim2.new(0, 0, 1, 0), Parent = track
                })
                local thumb = Make("Frame", {
                    BackgroundColor3 = C.Thumb, BorderSizePixel = 0,
                    Size = UDim2.fromOffset(7, 11), Position = UDim2.new(0, -3, 0.5, -5.5), Parent = track
                })
                Border(thumb, C.NearBlack, 1)

                local vLab
                if show then
                    vLab = Make("TextLabel", {
                        BackgroundTransparency = 1, Size = UDim2.new(0, 36, 1, 0), Position = UDim2.new(1, -42, 0, 0),
                        Font = Enum.Font.SourceSans, Text = tostring(def)..suf, TextColor3 = C.TextDark,
                        TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, Parent = r
                    })
                end

                local sliding = false
                local function Upd(v, fire)
                    v = math.clamp(math.floor(v / inc + 0.5) * inc, min, max)
                    val = v
                    local p = (max == min) and 0 or (v - min) / (max - min)
                    fill.Size = UDim2.new(p, 0, 1, 0)
                    thumb.Position = UDim2.new(p, -3, 0.5, -5.5)
                    if vLab then vLab.Text = tostring(v)..suf end
                    if fire ~= false then cb(v) end
                end
                local function From(pos)
                    local rel = (pos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
                    return min + (max - min) * math.clamp(rel, 0, 1)
                end

                track.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        sliding = true; Click(0.2, 1.15); Upd(From(i.Position))
                    end
                end)
                thumb.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                    end
                end)
                table.insert(win.Conns, UserInputService.InputChanged:Connect(function(i)
                    if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                        Upd(From(i.Position))
                    end
                end))
                table.insert(win.Conns, UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        if sliding then Click(0.22) end
                        sliding = false
                    end
                end))
                Upd(def, false)

                local api = {Set = function(_, v) Upd(v) end, Get = function() return val end}
                if o.Flag then Library.Flags[o.Flag] = api; win.Flags[o.Flag] = api end
                table.insert(sec.Elements, api)
                return api
            end

            function sec:AddDropdown(o)
                o = o or {}
                local text = o.Text or o.Name or "Dropdown"
                local list = o.List or o.Options or {"Option 1", "Option 2"}
                local def  = o.Default or list[1]
                local multi= o.Multi or false
                local cb   = o.Callback or function() end
                local sel  = multi and (type(def)=="table" and def or {}) or def

                local r = Make("Frame", {
                    BackgroundColor3 = C.Row, BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 26), LayoutOrder = #sec.Elements + 1, Parent = holder
                })
                Border(r, C.Border, 1)
                HoverTilt(r, 1.2)
                SolidSquare(r, 9, C.TextDark, UDim2.new(0, 8, 0.5, -4.5))
                Make("TextLabel", {
                    BackgroundTransparency = 1, Size = UDim2.new(0.42, 0, 1, 0), Position = UDim2.new(0, 24, 0, 0),
                    Font = Enum.Font.SourceSans, Text = text, TextColor3 = C.TextDark, TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left, Parent = r
                })

                local vBtn = Make("TextButton", {
                    BackgroundColor3 = C.InputBg, BorderSizePixel = 0,
                    Size = UDim2.new(0.5, -8, 0, 18), Position = UDim2.new(0.48, 0, 0.5, -9),
                    Font = Enum.Font.SourceSans, Text = multi and table.concat(sel, ", ") or tostring(sel),
                    TextColor3 = C.TextDark, TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd,
                    AutoButtonColor = false, Parent = r
                })
                Border(vBtn, C.Border, 1)

                local drop = Make("Frame", {
                    BackgroundColor3 = C.DropBg, BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 1, 2),
                    Visible = false, ZIndex = 40, ClipsDescendants = true, Parent = vBtn
                })
                Border(drop, C.NearBlack, 1)
                local dScroll = Make("ScrollingFrame", {
                    BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
                    CanvasSize = UDim2.new(0, 0, 0, 0), ScrollBarThickness = 2, BorderSizePixel = 0, Parent = drop
                })
                Make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Parent = dScroll})

                local open = false
                local function Rebuild()
                    for _, c in ipairs(dScroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
                    for i, opt in ipairs(list) do
                        local b = Make("TextButton", {
                            BackgroundColor3 = C.Row, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 22),
                            Font = Enum.Font.SourceSans, Text = "  "..tostring(opt), TextColor3 = C.TextDark,
                            TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
                            LayoutOrder = i, Parent = dScroll
                        })
                        b.MouseEnter:Connect(function() b.BackgroundColor3 = C.RowHover end)
                        b.MouseLeave:Connect(function() b.BackgroundColor3 = C.Row end)
                        b.MouseButton1Click:Connect(function()
                            Click(0.3)
                            if multi then
                                local idx = table.find(sel, opt)
                                if idx then table.remove(sel, idx) else table.insert(sel, opt) end
                                vBtn.Text = #sel > 0 and table.concat(sel, ", ") or "None"
                                cb(sel)
                            else
                                sel = opt; vBtn.Text = tostring(opt)
                                open = false; drop.Visible = false
                                TweenService:Create(drop, TweenInfo.new(0.12), {Size = UDim2.new(1,0,0,0)}):Play()
                                cb(opt)
                            end
                        end)
                    end
                    dScroll.CanvasSize = UDim2.new(0, 0, 0, #list * 22)
                end
                Rebuild()

                vBtn.MouseButton1Click:Connect(function()
                    open = not open
                    drop.Visible = open
                    local h = math.min(#list * 22, 130)
                    TweenService:Create(drop, TweenInfo.new(0.14), {
                        Size = open and UDim2.new(1, 0, 0, h) or UDim2.new(1, 0, 0, 0)
                    }):Play()
                    Click(0.28)
                end)

                local api = {
                    SetList = function(_, l) list = l; Rebuild() end,
                    Set = function(_, v)
                        if multi then sel = type(v)=="table" and v or {v}
                        else sel = v end
                        vBtn.Text = multi and table.concat(sel, ", ") or tostring(sel)
                    end,
                    Get = function() return sel end
                }
                if o.Flag then Library.Flags[o.Flag] = api; win.Flags[o.Flag] = api end
                table.insert(sec.Elements, api)
                return api
            end

            function sec:AddTextbox(o)
                o = o or {}
                local text = o.Text or o.Name or "Input"
                local def  = o.Default or ""
                local ph   = o.Placeholder or "..."
                local num  = o.Numeric or false
                local cb   = o.Callback or function() end

                local r = Make("Frame", {
                    BackgroundColor3 = C.Row, BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 26), LayoutOrder = #sec.Elements + 1, Parent = holder
                })
                Border(r, C.Border, 1)
                HoverTilt(r, 1.1)
                SolidSquare(r, 9, C.TextDark, UDim2.new(0, 8, 0.5, -4.5))
                Make("TextLabel", {
                    BackgroundTransparency = 1, Size = UDim2.new(0.38, 0, 1, 0), Position = UDim2.new(0, 24, 0, 0),
                    Font = Enum.Font.SourceSans, Text = text, TextColor3 = C.TextDark, TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left, Parent = r
                })
                local box = Make("TextBox", {
                    BackgroundColor3 = C.InputBg, BorderSizePixel = 0,
                    Size = UDim2.new(0.55, -6, 0, 18), Position = UDim2.new(0.42, 0, 0.5, -9),
                    Font = Enum.Font.SourceSans, Text = tostring(def), PlaceholderText = ph,
                    PlaceholderColor3 = Color3.fromRGB(120, 118, 100), TextColor3 = C.TextDark,
                    TextSize = 12, ClearTextOnFocus = false, Parent = r
                })
                Border(box, C.Border, 1)
                box.FocusLost:Connect(function()
                    local v = box.Text
                    if num then v = tonumber(v) or 0; box.Text = tostring(v) end
                    Click(0.25); cb(v)
                end)

                local api = {
                    Set = function(_, v) box.Text = tostring(v) end,
                    Get = function() return num and (tonumber(box.Text) or 0) or box.Text end
                }
                if o.Flag then Library.Flags[o.Flag] = api; win.Flags[o.Flag] = api end
                table.insert(sec.Elements, api)
                return api
            end

            function sec:AddKeybind(o)
                o = o or {}
                local text = o.Text or o.Name or "Keybind"
                local def  = o.Default or Enum.KeyCode.Unknown
                local cb   = o.Callback or function() end
                local cur  = def
                local listen = false

                local r = Make("Frame", {
                    BackgroundColor3 = C.Row, BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 26), LayoutOrder = #sec.Elements + 1, Parent = holder
                })
                Border(r, C.Border, 1)
                HoverTilt(r, 1.2)
                SolidSquare(r, 9, C.TextDark, UDim2.new(0, 8, 0.5, -4.5))
                Make("TextLabel", {
                    BackgroundTransparency = 1, Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.new(0, 24, 0, 0),
                    Font = Enum.Font.SourceSans, Text = text, TextColor3 = C.TextDark, TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left, Parent = r
                })
                local kBtn = Make("TextButton", {
                    BackgroundColor3 = C.InputBg, BorderSizePixel = 0,
                    Size = UDim2.new(0, 86, 0, 18), Position = UDim2.new(1, -96, 0.5, -9),
                    Font = Enum.Font.SourceSansBold, Text = cur == Enum.KeyCode.Unknown and "None" or cur.Name,
                    TextColor3 = C.TextDark, TextSize = 12, AutoButtonColor = false, Parent = r
                })
                Border(kBtn, C.Border, 1)

                kBtn.MouseButton1Click:Connect(function()
                    listen = true; kBtn.Text = "..."; Click(0.28)
                end)
                table.insert(win.Conns, UserInputService.InputBegan:Connect(function(i, g)
                    if listen and i.UserInputType == Enum.UserInputType.Keyboard then
                        cur = i.KeyCode; kBtn.Text = cur.Name; listen = false
                        Click(0.32); cb(cur)
                    end
                end))

                local api = {
                    Set = function(_, k) cur = k; kBtn.Text = k == Enum.KeyCode.Unknown and "None" or k.Name end,
                    Get = function() return cur end
                }
                if o.Flag then Library.Flags[o.Flag] = api; win.Flags[o.Flag] = api end
                table.insert(sec.Elements, api)
                return api
            end

            function sec:AddColorPicker(o)
                o = o or {}
                local text = o.Text or o.Name or "Color"
                local def  = o.Default or Color3.fromRGB(255, 255, 255)
                local cb   = o.Callback or function() end
                local cur  = def
                local pal  = {
                    Color3.fromRGB(255,255,255), Color3.fromRGB(0,0,0),
                    Color3.fromRGB(210,55,55), Color3.fromRGB(55,170,70),
                    Color3.fromRGB(55,110,210), Color3.fromRGB(230,190,40),
                    Color3.fromRGB(170,70,190), Color3.fromRGB(40,190,190),
                    Color3.fromRGB(230,130,40), Color3.fromRGB(130,130,130),
                }
                local idx = 1
                for i, c in ipairs(pal) do if c == def then idx = i break end end

                local r = Make("Frame", {
                    BackgroundColor3 = C.Row, BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 26), LayoutOrder = #sec.Elements + 1, Parent = holder
                })
                Border(r, C.Border, 1)
                HoverTilt(r, 1.1)
                SolidSquare(r, 9, C.TextDark, UDim2.new(0, 8, 0.5, -4.5))
                Make("TextLabel", {
                    BackgroundTransparency = 1, Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.new(0, 24, 0, 0),
                    Font = Enum.Font.SourceSans, Text = text, TextColor3 = C.TextDark, TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left, Parent = r
                })
                local prev = Make("TextButton", {
                    BackgroundColor3 = cur, BorderSizePixel = 0,
                    Size = UDim2.fromOffset(38, 16), Position = UDim2.new(1, -48, 0.5, -8),
                    Text = "", AutoButtonColor = false, Parent = r
                })
                Border(prev, C.NearBlack, 1)
                prev.MouseButton1Click:Connect(function()
                    idx = idx % #pal + 1; cur = pal[idx]; prev.BackgroundColor3 = cur
                    Click(0.3); cb(cur)
                end)

                local api = {Set = function(_, c) cur = c; prev.BackgroundColor3 = c end, Get = function() return cur end}
                if o.Flag then Library.Flags[o.Flag] = api; win.Flags[o.Flag] = api end
                table.insert(sec.Elements, api)
                return api
            end

            function sec:AddLabel(t)
                local r = Row(20)
                local l = Make("TextLabel", {
                    BackgroundTransparency = 1, Size = UDim2.new(1, -12, 1, 0), Position = UDim2.new(0, 8, 0, 0),
                    Font = Enum.Font.SourceSans, Text = tostring(t), TextColor3 = C.TextDark, TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left, Parent = r
                })
                local api = {SetText = function(_, v) l.Text = tostring(v) end}
                table.insert(sec.Elements, api)
                return api
            end

            function sec:AddParagraph(title, body)
                local r = Make("Frame", {
                    BackgroundColor3 = C.Row, BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                    LayoutOrder = #sec.Elements + 1, Parent = holder
                })
                Border(r, C.Border, 1)
                Make("TextLabel", {
                    BackgroundTransparency = 1, Size = UDim2.new(1, -12, 0, 15), Position = UDim2.new(0, 8, 0, 4),
                    Font = Enum.Font.SourceSansBold, Text = tostring(title or ""), TextColor3 = C.TextDark,
                    TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = r
                })
                Make("TextLabel", {
                    BackgroundTransparency = 1, Size = UDim2.new(1, -12, 0, 0), Position = UDim2.new(0, 8, 0, 20),
                    Font = Enum.Font.SourceSans, Text = tostring(body or ""), TextColor3 = Color3.fromRGB(90, 88, 75),
                    TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
                    AutomaticSize = Enum.AutomaticSize.Y, Parent = r
                })
                Make("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 5), Parent = r})
                table.insert(sec.Elements, r)
                return r
            end

            function sec:AddSeparator()
                local s = Make("Frame", {
                    BackgroundColor3 = C.Border, BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 1), LayoutOrder = #sec.Elements + 1, Parent = holder
                })
                table.insert(sec.Elements, s)
                return s
            end

            return sec
        end

        local defSec
        local function DS()
            if not defSec then defSec = tab:AddSection("") end
            return defSec
        end
        function tab:AddButton(o)      return DS():AddButton(o) end
        function tab:AddToggle(o)      return DS():AddToggle(o) end
        function tab:AddSlider(o)      return DS():AddSlider(o) end
        function tab:AddDropdown(o)    return DS():AddDropdown(o) end
        function tab:AddTextbox(o)     return DS():AddTextbox(o) end
        function tab:AddKeybind(o)     return DS():AddKeybind(o) end
        function tab:AddColorPicker(o) return DS():AddColorPicker(o) end
        function tab:AddLabel(t)       return DS():AddLabel(t) end
        function tab:AddParagraph(t,b) return DS():AddParagraph(t,b) end
        function tab:AddSeparator()    return DS():AddSeparator() end

        return tab
    end

    return win
end

function Library:GetFlag(f) return self.Flags[f] end
function Library:SetFlag(f, v) local a = self.Flags[f]; if a and a.Set then a:Set(v) end end
function Library:DestroyAll() for _, w in ipairs(self.Windows) do pcall(function() w:Destroy() end) end; self.Windows = {} end

function Library:CreateWatermark(text)
    local pg = LocalPlayer:WaitForChild("PlayerGui")
    local g = Make("ScreenGui", {Name = "IndWM", ResetOnSpawn = false, Parent = pg})
    local l = Make("TextLabel", {
        BackgroundColor3 = C.TitleBar, BorderSizePixel = 0,
        Size = UDim2.fromOffset(0, 20), Position = UDim2.new(0, 8, 0, 8),
        Font = Enum.Font.SourceSansBold, Text = "  "..(text or "Industrial UI").."  ",
        TextColor3 = C.TextLight, TextSize = 12, AutomaticSize = Enum.AutomaticSize.X, Parent = g
    })
    Border(l, C.NearBlack, 1)
    return {SetText = function(_, t) l.Text = "  "..t.."  " end, Destroy = function() g:Destroy() end}
end

