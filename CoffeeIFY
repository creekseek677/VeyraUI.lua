            function sec:AddButton(o)
                o = o or {}
                local text = o.Text or o.Name or "Button"
                local cb   = o.Callback or function() end

                local r = Make("TextButton", {
                    BackgroundColor3 = C.Row, BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 26), Text = "", AutoButtonColor = false,
