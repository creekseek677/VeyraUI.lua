    -- faint technical lines
    local bp = Make("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 1, Parent = content})
    for i = 1, 6 do
        Make("Frame", {
            BackgroundColor3 = Color3.fromRGB(185, 183, 160), BackgroundTransparency = 0.88,
            BorderSizePixel = 0, Size = UDim2.new(0, 1, 0.5, 0),
            Position = UDim2.new(0.55 + i * 0.05, 0, 0.4, 0), Rotation = 20 + i * 8, Parent = bp
