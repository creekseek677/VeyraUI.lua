local NotifHolder
local function EnsureNotifs()
    if NotifHolder and NotifHolder.Parent then return end
    local pg = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui")
    NotifHolder = Make("Frame", {
        Name = "IndustrialNotifs", BackgroundTransparency = 1,
        Size = UDim2.new(0, 270, 1, 0), Position = UDim2.new(1, -290, 0, 18),
        Parent = pg
    })
    Make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5), Parent = NotifHolder})
end

function Library:Notify(opts)
    opts = type(opts) == "string" and {Title = "Notice", Content = opts} or (opts or {})
    EnsureNotifs()
    local title = opts.Title or "Notice"
    local body  = opts.Content or opts.Text or ""
    local dur   = opts.Duration or 3.5
    local typ   = opts.Type or "Info"
    local col   = C.Accent
    if typ == "Success" then col = C.Success
    elseif typ == "Warning" then col = C.Warning
    elseif typ == "Error" then col = C.Danger end

    local n = Make("Frame", {
        BackgroundColor3 = C.NotifBg, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0), ClipsDescendants = true, Parent = NotifHolder
    })
    Border(n, C.NearBlack, 1)
    Make("Frame", {BackgroundColor3 = col, BorderSizePixel = 0, Size = UDim2.new(0, 3, 1, 0), Parent = n})
    Make("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, -18, 0, 16), Position = UDim2.new(0, 12, 0, 5),
        Font = Enum.Font.SourceSansBold, Text = title, TextColor3 = C.TextLight, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = n
    })
    Make("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, -18, 0, 30), Position = UDim2.new(0, 12, 0, 22),
        Font = Enum.Font.SourceSans, Text = body, TextColor3 = Color3.fromRGB(195, 193, 175),
        TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true, Parent = n
    })
    TweenService:Create(n, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {Size = UDim2.new(1, 0, 0, 58)}):Play()
    Click(0.22, 1.1)
    task.delay(dur, function()
        if n.Parent then
            TweenService:Create(n, TweenInfo.new(0.18), {Size = UDim2.new(1, 0, 0, 0)}):Play()
            task.wait(0.2) n:Destroy()
        end
    end)
end

