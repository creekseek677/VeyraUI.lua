local function Make(class, props)
    local i = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then pcall(function() i[k] = v end) end
    end
    if props and props.Parent then i.Parent = props.Parent end
    return i
end

local function Border(parent, color, thick)
    thick = thick or 1
    color = color or C.Border
    local z = (parent.ZIndex or 1) + 2
    for _, d in ipairs({
        {UDim2.new(1,0,0,thick), UDim2.new(0,0,0,0)},
        {UDim2.new(1,0,0,thick), UDim2.new(0,0,1,-thick)},
        {UDim2.new(0,thick,1,0), UDim2.new(0,0,0,0)},
        {UDim2.new(0,thick,1,0), UDim2.new(1,-thick,0,0)},
    }) do
        Make("Frame", {
            BackgroundColor3 = color, BorderSizePixel = 0,
            Size = d[1], Position = d[2], ZIndex = z, Parent = parent
        })
    end
end

local function SolidSquare(parent, size, color, pos)
    return Make("Frame", {
        BackgroundColor3 = color or C.TextDark,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(size, size),
        Position = pos,
        ZIndex = (parent.ZIndex or 1) + 1,
        Parent = parent
    })
end

local function HoverTilt(frame, amt)
    amt = amt or 1.6
    frame.MouseEnter:Connect(function()
        TweenService:Create(frame, TweenInfo.new(0.11, Enum.EasingStyle.Quad), {Rotation = amt}):Play()
    end)
    frame.MouseLeave:Connect(function()
        TweenService:Create(frame, TweenInfo.new(0.14, Enum.EasingStyle.Quad), {Rotation = 0}):Play()
    end)
end

local function ClickTilt(frame)
    frame.MouseButton1Down:Connect(function()
        Click(0.4, 0.95)
        TweenService:Create(frame, TweenInfo.new(0.05), {Rotation = -1.3}):Play()
    end)
    frame.MouseButton1Up:Connect(function()
        TweenService:Create(frame, TweenInfo.new(0.1), {Rotation = 1.4}):Play()
        task.delay(0.1, function()
            if frame.Parent then
                TweenService:Create(frame, TweenInfo.new(0.12), {Rotation = 0}):Play()
            end
        end)
    end)
end

