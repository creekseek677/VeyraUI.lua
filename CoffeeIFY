			Color = Theme.MutedText,
		})

		local countryLabel = about:CreateLabel({
			Text = "Country: …",
			Color = Theme.MutedText,
		})

		-- resolve country
		task.spawn(function()
			local country = "Unknown"
			local ok, result = pcall(function()
				local LocalizationService = game:GetService("LocalizationService")
				if LocalPlayer then
					return LocalizationService:GetCountryRegionForPlayerAsync(LocalPlayer)
				end
				return nil
			end)
			if ok and type(result) == "string" and result ~= "" then
				country = result
			end
			countryLabel:SetValue("Country: " .. country)
		end)

		about:CreateLabel({ Text = " " }) -- spacer
		about:CreateLabel({
			Text = "I once found a YouTube video of a ui library preview, and it said it was paid so I made my own replica but free for all.",
			Color = Theme.MutedText,
			TextSize = 11,
		})
	end)

	-- intro assemble
	w:_intro()
	return w
end

-- Notify
function CoffeeIFY:Notify(text, duration)
	text = tostring(text or "Notification")
	duration = duration or 3
	assert(PlayerGui, "CoffeeIFY requires PlayerGui")

	local holder = new("Frame", {
		Name = "CoffeeIFYNotify",
		Size = UDim2.fromOffset(0, 28),
		Position = UDim2.new(0.5, 0, 1, -50),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Theme.Bg,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 300,
		Parent = PlayerGui:FindFirstChild("CoffeeIFY") or PlayerGui,
	})
	applyStroke(holder, 1)

	local label = new("TextLabel", {
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = Theme.Text,
		Font = Visual.Font,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 301,
		Parent = holder,
	})

	PlaySound(ALERT_SOUND, 0.5)
	local targetW = clamp(#text * 7 + 30, 120, 320)
	Anim.tween(holder, 0.25, { Size = UDim2.fromOffset(targetW, 28) }, Enum.EasingStyle.Back)

	task.spawn(function()
		for i = 1, #text do
			if not label.Parent then return end
			label.Text = string.sub(text, 1, i)
			task.wait(0.025)
		end
	end)

	task.delay(duration, function()
		if not holder.Parent then return end
		Anim.tween(holder, 0.22, { Size = UDim2.fromOffset(0, 28), BackgroundTransparency = 1 })
		Anim.tween(label, 0.2, { TextTransparency = 1 })
		task.wait(0.25)
		if holder.Parent then holder:Destroy() end
	end)

	return holder
end

return setmetatable({}, CoffeeIFY)
