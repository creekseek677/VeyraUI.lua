local CoffeeIFY = {}
CoffeeIFY.__index = CoffeeIFY

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer

-- destroy old
if player.PlayerGui:FindFirstChild("CoffeeIFY") then
	player.PlayerGui.CoffeeIFY:Destroy()
end

local function Create(class, props)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	return inst
end

local function Tween(obj, props, duration, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(duration or 0.35, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

-- sound system
local HOVER_SOUND = 408524543
local CLICK_SOUND = 4307186075

local function PlaySound(id, volume)
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. tostring(id)
	s.Volume = volume or 0.4
	s.PlaybackSpeed = 1
	s.Parent = SoundService
	s:Play()
	s.Ended:Connect(function()
		s:Destroy()
	end)
end

local function AddHoverClick(btn)
	btn.MouseEnter:Connect(function()
		PlaySound(HOVER_SOUND, 0.25)
	end)
	btn.MouseButton1Click:Connect(function()
		PlaySound(CLICK_SOUND, 0.45)
	end)
	-- touch support
	btn.TouchTap:Connect(function()
		PlaySound(CLICK_SOUND, 0.45)
	end)
end

function CoffeeIFY.new(config)
	config = config or {}
	local self = setmetatable({}, CoffeeIFY)

	self.gui = Create("ScreenGui", {
		Name = "CoffeeIFY",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		Parent = player.PlayerGui
	})

	-- ===================== FULLSCREEN INTRO =====================
	local intro = Create("Frame", {
		Name = "Intro",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(232, 224, 205),
		BorderSizePixel = 0,
		ZIndex = 100,
		Parent = self.gui
	})

	local introTitle = Create("TextLabel", {
		Text = "CoffeeIFY",
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.new(0, 0, 0.42, 0),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(50, 45, 40),
		Font = Enum.Font.GothamBold,
		TextSize = 28,
		Parent = intro
	})

	local loadingText = Create("TextLabel", {
		Name = "LoadingText",
		Text = "loading",
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.new(0, 0, 0.5, 10),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(90, 80, 70),
		Font = Enum.Font.Gotham,
		TextSize = 14,
		Parent = intro
	})

	-- fake "piecing" frames that assemble
	local pieces = {}
	for i = 1, 8 do
		local p = Create("Frame", {
			Size = UDim2.new(0, 18, 0, 18),
			Position = UDim2.new(0.5, math.random(-220, 220), 0.5, math.random(-160, 160)),
			BackgroundColor3 = Color3.fromRGB(60, 55, 50),
			BorderSizePixel = 0,
			BackgroundTransparency = 0.4,
			Parent = intro
		})
		pieces[i] = p
	end

	-- animate pieces flying to center then form the window shape
	task.spawn(function()
		-- dots animation
		local dots = 0
		local dotConn
		dotConn = RunService.Heartbeat:Connect(function()
			dots = (dots % 3) + 1
			loadingText.Text = "loading" .. string.rep(".", dots)
		end)

		task.wait(0.4)

		-- pieces move toward center
		for i, p in ipairs(pieces) do
			Tween(p, {
				Position = UDim2.new(0.5, -40 + (i % 4) * 22, 0.5, -30 + math.floor((i - 1) / 4) * 22),
				BackgroundTransparency = 0.15
			}, 0.55 + i * 0.04, Enum.EasingStyle.Back)
		end

		task.wait(0.85)

		-- final assemble flash
		for _, p in ipairs(pieces) do
			Tween(p, {BackgroundTransparency = 0, Size = UDim2.new(0, 22, 0, 22)}, 0.25)
		end

		task.wait(0.35)

		-- fade intro out
		Tween(introTitle, {TextTransparency = 1}, 0.4)
		Tween(loadingText, {TextTransparency = 1}, 0.4)
		for _, p in ipairs(pieces) do
			Tween(p, {BackgroundTransparency = 1}, 0.4)
		end
		Tween(intro, {BackgroundTransparency = 1}, 0.5)

		task.wait(0.55)
		dotConn:Disconnect()
		intro:Destroy()

		-- finally show main UI
		self.main.Visible = true
		Tween(self.main, {BackgroundTransparency = 0}, 0.35)
	end)

	-- ===================== MAIN WINDOW =====================
	-- responsive base size (clamped)
	local cam = workspace.CurrentCamera
	local vp = cam.ViewportSize
	local base = math.clamp(math.min(vp.X, vp.Y) * 0.42, 300, 420)

	self.main = Create("Frame", {
		Name = "Main",
		Size = UDim2.new(0, base, 0, base),
		Position = UDim2.new(0.5, -base / 2, 0.5, -base / 2),
		BackgroundColor3 = Color3.fromRGB(232, 224, 205),
		BackgroundTransparency = 1, -- starts invisible until intro ends
		BorderSizePixel = 0,
		Visible = false,
		Parent = self.gui
	})

	Create("UIStroke", {
		Color = Color3.fromRGB(170, 160, 140),
		Thickness = 1.5,
		Parent = self.main
	})

	-- TOP BAR
	self.topBar = Create("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundColor3 = Color3.fromRGB(42, 38, 34),
		BorderSizePixel = 0,
		Parent = self.main
	})

	self.title = Create("TextLabel", {
		Text = "◆  CoffeeIFY",
		Size = UDim2.new(1, -90, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(225, 215, 195),
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = self.topBar
	})

	-- MINIMIZE BUTTON (lucide-style)
	local minBtn = Create("TextButton", {
		Name = "Minimize",
		Size = UDim2.new(0, 28, 0, 28),
		Position = UDim2.new(1, -56, 0, 0),
		BackgroundTransparency = 1,
		Text = "–",
		TextColor3 = Color3.fromRGB(200, 190, 170),
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		AutoButtonColor = false,
		Parent = self.topBar
	})

	-- CLOSE BUTTON
	local closeBtn = Create("TextButton", {
		Name = "Close",
		Size = UDim2.new(0, 28, 0, 28),
		Position = UDim2.new(1, -28, 0, 0),
		BackgroundTransparency = 1,
		Text = "×",
		TextColor3 = Color3.fromRGB(200, 190, 170),
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		AutoButtonColor = false,
		Parent = self.topBar
	})

	minBtn.MouseEnter:Connect(function()
		PlaySound(HOVER_SOUND, 0.2)
		Tween(minBtn, {TextColor3 = Color3.fromRGB(255, 255, 255)}, 0.15)
	end)
	minBtn.MouseLeave:Connect(function()
		Tween(minBtn, {TextColor3 = Color3.fromRGB(200, 190, 170)}, 0.15)
	end)

	closeBtn.MouseEnter:Connect(function()
		PlaySound(HOVER_SOUND, 0.2)
		Tween(closeBtn, {TextColor3 = Color3.fromRGB(255, 120, 120)}, 0.15)
	end)
	closeBtn.MouseLeave:Connect(function()
		Tween(closeBtn, {TextColor3 = Color3.fromRGB(200, 190, 170)}, 0.15)
	end)

	local minimized = false
	minBtn.MouseButton1Click:Connect(function()
		PlaySound(CLICK_SOUND, 0.4)
		minimized = not minimized
		if minimized then
			Tween(self.main, {Size = UDim2.new(0, base, 0, 28)}, 0.3, Enum.EasingStyle.Quad)
		else
			Tween(self.main, {Size = UDim2.new(0, base, 0, base)}, 0.3, Enum.EasingStyle.Quad)
		end
	end)
	minBtn.TouchTap:Connect(function()
		PlaySound(CLICK_SOUND, 0.4)
		minimized = not minimized
		if minimized then
			Tween(self.main, {Size = UDim2.new(0, base, 0, 28)}, 0.3, Enum.EasingStyle.Quad)
		else
			Tween(self.main, {Size = UDim2.new(0, base, 0, base)}, 0.3, Enum.EasingStyle.Quad)
		end
	end)

	-- CLOSE + DISASSEMBLY ANIMATION
	local function doClose()
		PlaySound(CLICK_SOUND, 0.45)
		-- first fade everything to plain beige
		Tween(self.topBar, {BackgroundTransparency = 1}, 0.35)
		Tween(self.sidebar, {BackgroundTransparency = 1}, 0.35)
		Tween(self.content, {BackgroundTransparency = 1}, 0.35)
		Tween(self.title, {TextTransparency = 1}, 0.3)
		Tween(minBtn, {TextTransparency = 1}, 0.3)
		Tween(closeBtn, {TextTransparency = 1}, 0.3)

		for _, child in ipairs(self.sidebar:GetDescendants()) do
			if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("Frame") then
				if child:IsA("TextLabel") or child:IsA("TextButton") then
					Tween(child, {TextTransparency = 1}, 0.3)
				else
					Tween(child, {BackgroundTransparency = 1}, 0.3)
				end
			end
		end
		for _, child in ipairs(self.content:GetDescendants()) do
			if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("Frame") or child:IsA("TextBox") then
				if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
					Tween(child, {TextTransparency = 1}, 0.3)
				else
					Tween(child, {BackgroundTransparency = 1}, 0.3)
				end
			end
		end

		-- then shrink + fade the whole window to beige
		task.wait(0.25)
		Tween(self.main, {
			Size = UDim2.new(0, base * 0.7, 0, base * 0.7),
			BackgroundColor3 = Color3.fromRGB(232, 224, 205),
			BackgroundTransparency = 0.2
		}, 0.4)

		task.wait(0.35)
		Tween(self.main, {
			Size = UDim2.new(0, 20, 0, 20),
			BackgroundTransparency = 1,
			Position = UDim2.new(0.5, -10, 0.5, -10)
		}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In)

		task.wait(0.4)
		self.gui:Destroy()
	end

	closeBtn.MouseButton1Click:Connect(doClose)
	closeBtn.TouchTap:Connect(doClose)

	-- SIDEBAR
	self.sidebar = Create("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, 98, 1, -28),
		Position = UDim2.new(0, 0, 0, 28),
		BackgroundColor3 = Color3.fromRGB(205, 195, 175),
		BorderSizePixel = 0,
		Parent = self.main
	})

	Create("UIStroke", {
		Color = Color3.fromRGB(170, 160, 140),
		Thickness = 1,
		Parent = self.sidebar
	})

	-- CONTENT
	self.content = Create("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -98, 1, -28),
		Position = UDim2.new(0, 98, 0, 28),
		BackgroundColor3 = Color3.fromRGB(232, 224, 205),
		BorderSizePixel = 0,
		Parent = self.main
	})

	self.contentTitle = Create("TextLabel", {
		Name = "Title",
		Text = "TAB 1",
		Size = UDim2.new(1, -16, 0, 28),
		Position = UDim2.new(0, 12, 0, 6),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(35, 30, 25),
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = self.content
	})

	self.pages = Create("Folder", {
		Name = "Pages",
		Parent = self.content
	})

	self.tabs = {}
	self.tabButtons = {}
	self.currentTab = nil
	self.tabCount = 0

	-- dragging (mouse + touch)
	local dragging, dragStart, startPos
	local function beginDrag(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = self.main.Position
		end
	end
	local function endDrag(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end
	local function updateDrag(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			self.main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end

	self.topBar.InputBegan:Connect(beginDrag)
	UserInputService.InputEnded:Connect(endDrag)
	UserInputService.InputChanged:Connect(updateDrag)

	-- responsive resize on viewport change
	cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		local newVp = cam.ViewportSize
		local newBase = math.clamp(math.min(newVp.X, newVp.Y) * 0.42, 300, 420)
		if not minimized then
			self.main.Size = UDim2.new(0, newBase, 0, newBase)
		else
			self.main.Size = UDim2.new(0, newBase, 0, 28)
		end
		base = newBase
	end)

	return self
end

-- ===================== CREATE TAB =====================
function CoffeeIFY:CreateTab(name)
	self.tabCount += 1
	local index = self.tabCount

	local btn = Create("TextButton", {
		Name = name,
		Size = UDim2.new(1, -10, 0, 26),
		Position = UDim2.new(0, 5, 0, 6 + (index - 1) * 30),
		BackgroundColor3 = Color3.fromRGB(185, 175, 155),
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = self.sidebar
	})

	local icon = Create("Frame", {
		Size = UDim2.new(0, 7, 0, 7),
		Position = UDim2.new(0, 7, 0.5, -3.5),
		BackgroundColor3 = Color3.fromRGB(70, 60, 50),
		BorderSizePixel = 0,
		Parent = btn
	})

	local label = Create("TextLabel", {
		Text = name,
		Size = UDim2.new(1, -22, 1, 0),
		Position = UDim2.new(0, 18, 0, 0),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(45, 40, 35),
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = btn
	})

	local page = Create("ScrollingFrame", {
		Name = name,
		Size = UDim2.new(1, -16, 1, -42),
		Position = UDim2.new(0, 8, 0, 36),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Color3.fromRGB(140, 130, 110),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = self.pages
	})

	Create("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = page
	})

	Create("UIPadding", {
		PaddingTop = UDim.new(0, 2),
		PaddingBottom = UDim.new(0, 6),
		Parent = page
	})

	local tabData = {
		Button = btn,
		Icon = icon,
		Label = label,
		Page = page,
		Name = name
	}

	self.tabs[name] = tabData
	self.tabButtons[index] = tabData

	local function select()
		PlaySound(CLICK_SOUND, 0.35)
		for _, t in pairs(self.tabs) do
			Tween(t.Button, {BackgroundColor3 = Color3.fromRGB(185, 175, 155)}, 0.2)
			Tween(t.Label, {TextColor3 = Color3.fromRGB(45, 40, 35)}, 0.2)
			Tween(t.Icon, {BackgroundColor3 = Color3.fromRGB(70, 60, 50)}, 0.2)
			t.Page.Visible = false
		end
		Tween(btn, {BackgroundColor3 = Color3.fromRGB(48, 43, 38)}, 0.22)
		Tween(label, {TextColor3 = Color3.fromRGB(230, 220, 200)}, 0.22)
		Tween(icon, {BackgroundColor3 = Color3.fromRGB(230, 220, 200)}, 0.22)
		page.Visible = true
		self.contentTitle.Text = name
		self.currentTab = tabData
	end

	btn.MouseEnter:Connect(function()
		PlaySound(HOVER_SOUND, 0.18)
		if self.currentTab ~= tabData then
			Tween(btn, {BackgroundColor3 = Color3.fromRGB(200, 190, 170)}, 0.15)
		end
	end)
	btn.MouseLeave:Connect(function()
		if self.currentTab ~= tabData then
			Tween(btn, {BackgroundColor3 = Color3.fromRGB(185, 175, 155)}, 0.15)
		end
	end)

	btn.MouseButton1Click:Connect(select)
	btn.TouchTap:Connect(select)

	if index == 1 then
		select()
	end

	return tabData
end

