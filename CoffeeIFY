local function PlaySound(id, volume)
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. tostring(id)
	sound.Volume = volume or 0.4
	sound.PlaybackSpeed = 1
	sound.Parent = SoundService
	sound:Play()

	sound.Ended:Connect(function()
		if sound then
			sound:Destroy()
		end
	end)

	return sound
end

local function BindActivated(button, callback)
	return button.Activated:Connect(callback)
end

local function MeasureText(text, font, size, width)
	text = tostring(text or "")
	local bounds = TextService:GetTextSize(
		text,
		size,
		font,
		Vector2.new(math.max(width or 1, 1), 10000)
	)
	return math.max(bounds.X, 1), math.max(bounds.Y, 1)
end

local function AddHoverSweep(frame, hit, visuals, baseColor, darkColor)
	local sweep = Create("Frame", {
		Name = "HoverSweep",
		AnchorPoint = Vector2.new(1, 0),
		Size = UDim2.new(0, 0, 1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = darkColor,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = frame
	})

	local topLine = Create("Frame", {
		Name = "HoverTopLine",
		Size = UDim2.new(0, 0, 0, 1),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundColor3 = THEME.DarkLine,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = frame
	})
	local bottomLine = Create("Frame", {
		Name = "HoverBottomLine",
		AnchorPoint = Vector2.new(0, 1),
		Size = UDim2.new(0, 0, 0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = THEME.DarkLine,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = frame
	})

	for _, obj in ipairs(visuals or {}) do
		if obj and obj:IsA("GuiObject") then
			obj.ZIndex = 3
		end
	end
	if hit and hit:IsA("GuiObject") then
		hit.ZIndex = 5
	end

	local hovered = false
	local locked = false

	local function animate(active)
		if not frame.Parent then return end
		hovered = active

		if active or locked then
			Tween(sweep, {
				Size = UDim2.new(1, 0, 1, 0),
				Position = UDim2.new(0, 0, 0, 0)
			}, 0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			Tween(topLine, {Size = UDim2.new(1, 0, 0, 1)}, 0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			Tween(bottomLine, {Size = UDim2.new(1, 0, 0, 1)}, 0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		else
			Tween(sweep, {
				Size = UDim2.new(0, 0, 1, 0),
				Position = UDim2.new(1, 0, 0, 0)
			}, 0.14, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			Tween(topLine, {Size = UDim2.new(0, 0, 0, 1)}, 0.14, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			Tween(bottomLine, {Size = UDim2.new(0, 0, 0, 1)}, 0.14, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		end
	end

	if hit then
		hit.MouseEnter:Connect(function()
			if locked then return end
			animate(true)
		end)
		hit.MouseLeave:Connect(function()
			if locked then return end
			animate(false)
		end)
	end

	return {
		SetLocked = function(_, value)
			locked = value == true
			animate(locked or hovered)
		end,
		IsLocked = function()
			return locked
		end,
		TopLine = topLine,
		BottomLine = bottomLine,
		Sweep = sweep
	}
end

local function GetPageWidth(page, fallback)
	local width = page and page.AbsoluteSize.X or 0
	if width > 0 then
		return width
	end

	local ancestor = page
	while ancestor and ancestor.Parent do
		ancestor = ancestor.Parent
		if ancestor:IsA("GuiObject") and ancestor.Name == "Main" then
			local rootWidth = ancestor.AbsoluteSize.X
			if rootWidth <= 0 then
				rootWidth = ancestor.Size.X.Offset
			end
			return math.max(rootWidth - 158, 120)
		end
	end

	return fallback or 260
end


function CoffeeIFY:_Track(connection)
	self._connections = self._connections or {}
	table.insert(self._connections, connection)
	return connection
end

function CoffeeIFY:_CleanupConnections()
	if not self._connections then
		return
	end

	for _, connection in ipairs(self._connections) do
		if connection and connection.Connected then
			connection:Disconnect()
		end
	end

	table.clear(self._connections)
end

function CoffeeIFY:_GetPage(tab)
	if typeof(tab) == "table" then
		return tab.Page
	end

	local tabData = self.tabs and self.tabs[tab]

	if not tabData then
		error(("CoffeeIFY: tab '%s' does not exist."):format(tostring(tab)))
	end

	return tabData.Page
end

function CoffeeIFY:Notify(message, duration)
	if self._closing or not self.notificationHolder or not self.notificationHolder.Parent then
		return
	end

	message = tostring(message or "alert")
	duration = tonumber(duration) or 2.5
	self._notificationId = (self._notificationId or 0) + 1

	local card = Create("Frame", {
		Name = "Alert",
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundColor3 = THEME.Dark,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 201,
		LayoutOrder = self._notificationId,
		Parent = self.notificationHolder
	})

	local accent = Create("Frame", {
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = THEME.TextLight,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 202,
		Parent = card
	})

	local title = Create("TextLabel", {
		Text = "alert",
		Size = UDim2.new(1, -22, 0, 18),
		Position = UDim2.new(0, 14, 0, 5),
		BackgroundTransparency = 1,
		TextColor3 = THEME.TextLight,
		TextTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 202,
		Parent = card
	})

	local body = Create("TextLabel", {
		Text = message,
		Size = UDim2.new(1, -22, 0, 18),
		Position = UDim2.new(0, 14, 0, 22),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(209, 202, 187),
		TextTransparency = 1,
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 202,
		Parent = card
	})

	PlaySound(self._notificationSoundId or NOTIFY_SOUND, 0.24)
	Tween(card, {BackgroundTransparency = 0}, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	Tween(accent, {BackgroundTransparency = 0}, 0.16)
	Tween(title, {TextTransparency = 0}, 0.16)
	Tween(body, {TextTransparency = 0}, 0.18)

	task.delay(duration, function()
		if not card.Parent then return end
		Tween(card, {BackgroundTransparency = 1}, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Tween(accent, {BackgroundTransparency = 1}, 0.16)
		Tween(title, {TextTransparency = 1}, 0.14)
		Tween(body, {TextTransparency = 1}, 0.14)
		task.delay(0.2, function()
			if card.Parent then card:Destroy() end
		end)
	end)

	return card
end

