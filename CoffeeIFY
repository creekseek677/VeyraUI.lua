	})
	iconInDark.Parent = overlay

	Anim.bindHoverInvasion(btn, overlay, { time = 0.12 })
	Anim.bindPress(btn)

	return btn, icon, iconInDark
end

local function setLucide(iconLabel: ImageLabel, name: string)
	-- This library expects lucide.lua, but provides a safe fallback.
	-- If lucide is not found, icon stays empty.
	local get = Icons.get(name)
	if get then
		local ok, imageId = pcall(get, 18)
		if ok and type(imageId) == "string" then
			iconLabel.Image = imageId
		end
	else
		iconLabel.Image = ""
	end
end

function Window:_setInteractionEnabled(enabled: boolean)
	self._interactive = enabled
	if self._rootFrame then
		(self._rootFrame :: Frame).Active = enabled
		(self._rootFrame :: Frame).Selectable = enabled
	end
	if self._shield then
		(self._shield :: Frame).Visible = not enabled
	end
end

function Window:_intro()
	-- assembling: header slides in, sidebar clips reveal, content clips reveal
	local root = self._rootFrame :: Frame
	local header = self._header :: Frame
	local sidebar = self._sidebar :: Frame
	local content = self._content :: Frame

	root.Visible = true
	root.BackgroundTransparency = 1
	header.BackgroundTransparency = 1
	sidebar.BackgroundTransparency = 1
	content.BackgroundTransparency = 1

	-- pre-offsets. Always assemble back to the original home position.
	local rootPos = self._homePosition or root.Position
	root.Position = UDim2.new(rootPos.X.Scale, rootPos.X.Offset, rootPos.Y.Scale, rootPos.Y.Offset + 14)
	root.Size = UDim2.fromOffset(Visual.WindowSize.X.Offset - 20, Visual.WindowSize.Y.Offset - 10)

	local headerPos = header.Position
	header.Position = UDim2.new(headerPos.X.Scale, headerPos.X.Offset, headerPos.Y.Scale, headerPos.Y.Offset - 8)

	sidebar.ClipsDescendants = true
	content.ClipsDescendants = true
	sidebar.Size = UDim2.fromOffset(Visual.SidebarW, 0)
	content.Size = UDim2.new(1, -Visual.SidebarW, 1, -Visual.HeaderH)

	self:_setInteractionEnabled(false)

	Anim.tween(root, 0.18, { BackgroundTransparency = 0, Position = rootPos, Size = Visual.WindowSize }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	Anim.tween(header, 0.16, { BackgroundTransparency = 0, Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	Anim.tween(sidebar, 0.18, { BackgroundTransparency = 0, Size = UDim2.new(0, Visual.SidebarW, 1, -Visual.HeaderH) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	Anim.tween(content, 0.18, { BackgroundTransparency = 0, Size = UDim2.new(1, -Visual.SidebarW, 1, -Visual.HeaderH) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	task.delay(0.22, function()
		if self._closing then return end
		sidebar.ClipsDescendants = false
		content.ClipsDescendants = false
		self:_setInteractionEnabled(true)
	end)
end

function Window:_outro(destroyAfter: boolean)
	if self._closing then return end
	self._closing = true
	self:_setInteractionEnabled(false)

	local root = self._rootFrame :: Frame
	local header = self._header :: Frame
	local sidebar = self._sidebar :: Frame
	local content = self._content :: Frame

	sidebar.ClipsDescendants = true
	content.ClipsDescendants = true

	-- disassemble: collapse sidebar+content, drift down, fade
	Anim.tween(sidebar, 0.16, { Size = UDim2.fromOffset(Visual.SidebarW, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Anim.tween(content, 0.16, { Size = UDim2.new(1, -Visual.SidebarW, 0, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Anim.tween(header, 0.14, { Position = UDim2.fromOffset(0, -8), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Anim.tween(root, 0.18, { Position = UDim2.new(root.Position.X.Scale, root.Position.X.Offset, root.Position.Y.Scale, root.Position.Y.Offset + 12), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

	task.delay(0.22, function()
		if destroyAfter then
			self:Destroy()
		else
			root.Visible = false
			root.Position = self._homePosition or root.Position
			root.Size = Visual.WindowSize
			self._closing = false
		end
	end)
end

function Window:Toggle()
	if self._closing then return end
	self._visible = not self._visible
	if self._visible then
		(self._rootFrame :: Frame).Visible = true
		self:_intro()
	else
		-- quick hide with disassembly but keep instance for state
		self:_outro(false)
	end
end

function Window:Minimize()
	if self._closing then return end
	self._minimized = not self._minimized
	local sidebar = self._sidebar :: Frame
	local content = self._content :: Frame
	local root = self._rootFrame :: Frame

	self:_setInteractionEnabled(false)
	if self._minimized then
		sidebar.ClipsDescendants = true
		content.ClipsDescendants = true
		Anim.tween(sidebar, 0.16, { Size = UDim2.fromOffset(Visual.SidebarW, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		Anim.tween(content, 0.16, { Size = UDim2.new(1, -Visual.SidebarW, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		Anim.tween(root, 0.16, { Size = UDim2.fromOffset(Visual.WindowSize.X.Offset, Visual.HeaderH + 2) }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		task.delay(0.18, function()
			if self._closing then return end
			sidebar.Visible = false
			content.Visible = false
			sidebar.ClipsDescendants = false
			content.ClipsDescendants = false
			self:_setInteractionEnabled(true)
		end)
	else
		sidebar.Visible = true
		content.Visible = true
		sidebar.ClipsDescendants = true
		content.ClipsDescendants = true
		Anim.tween(root, 0.16, { Size = Visual.WindowSize }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		Anim.tween(sidebar, 0.18, { Size = UDim2.new(0, Visual.SidebarW, 1, -Visual.HeaderH) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		Anim.tween(content, 0.18, { Size = UDim2.new(1, -Visual.SidebarW, 1, -Visual.HeaderH) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.delay(0.2, function()
			if self._closing then return end
			sidebar.ClipsDescendants = false
			content.ClipsDescendants = false
			self:_setInteractionEnabled(true)
		end)
	end
end

function Window:Close()
	if self._closing then return end
	self:_outro(true)
end

function Window:Destroy()
	-- disconnect input connections
	for _, c in ipairs(self._connections) do
		pcall(function() c:Disconnect() end)
	end
	for i, w in ipairs(Global.Windows) do
		if w == self then
			table.remove(Global.Windows, i)
			break
		end
	end
	if self._screenGui then
		(self._screenGui :: ScreenGui):Destroy()
	end
end

function Window:CreateTab(opts)
	opts = opts or {}
	local tab = setmetatable({}, Tab)
	tab.Window = self
	tab.Name = tostring(opts.Name or "Tab")
	tab.Icon = tostring(opts.Icon or "")
	tab.Sections = {}
	tab._selected = false

	-- Sidebar button
	local btn = new("TextButton", {
		Name = tab.Name,
		BackgroundColor3 = Theme.Control,
		Size = UDim2.fromOffset(Visual.TabNormalW, Visual.TabH),
		AutoButtonColor = false,
		Text = "",
	})
	applyCorner(btn, 3)
	applyStroke(btn, 1)
	btn.Parent = self._tabList

	local overlay = new("Frame", {
		Name = "Dark",
		BackgroundColor3 = Theme.Dark,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Position = UDim2.fromScale(0, 0),
		ZIndex = btn.ZIndex + 1,
		ClipsDescendants = true,
	})
	applyCorner(overlay, 3)
	overlay.Parent = btn

	local icon = new("ImageLabel", {
		Name = "Icon",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(14, 14),
		Position = UDim2.fromOffset(8, 7),
		Image = "",
		ImageColor3 = Theme.Text,
		ZIndex = btn.ZIndex + 2,
	})
	icon.Parent = btn
	local iconDark = new("ImageLabel", {
		Name = "IconDark",
		BackgroundTransparency = 1,
		Size = icon.Size,
		Position = icon.Position,
		Image = "",
		ImageColor3 = Theme.White,
		ZIndex = overlay.ZIndex + 2,
	})
	iconDark.Parent = overlay

	if tab.Icon ~= "" then
		setLucide(icon, tab.Icon)
		setLucide(iconDark, tab.Icon)
	else
		icon.Visible = false
		iconDark.Visible = false
	end

	local lbl = new("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Text = string.upper(tab.Name),
		Font = Visual.FontBold,
		TextSize = Visual.TextSize,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -28, 1, 0),
		Position = UDim2.fromOffset(26, 0),
		ZIndex = btn.ZIndex + 2,
	})
	lbl.Parent = btn
	local lblDark = new("TextLabel", {
		Name = "LabelDark",
		BackgroundTransparency = 1,
		Text = lbl.Text,
		Font = Visual.FontBold,
		TextSize = Visual.TextSize,
		TextColor3 = Theme.White,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = lbl.Size,
		Position = lbl.Position,
		ZIndex = overlay.ZIndex + 2,
	})
	lblDark.Parent = overlay

	-- Tabs use the same dark invasion hover, but selected tabs keep the dark state visible.
	btn.MouseEnter:Connect(function()
		Anim.tween(overlay, 0.14, { Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end)
	btn.MouseLeave:Connect(function()
		if not tab._selected then
			Anim.tween(overlay, 0.14, { Size = UDim2.fromScale(0, 1), Position = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end)
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			Anim.tween(overlay, 0.14, { Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end)
	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch and not tab._selected then
			Anim.tween(overlay, 0.14, { Size = UDim2.fromScale(0, 1), Position = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end)
	Anim.bindPress(btn)

	btn.MouseButton1Click:Connect(function()
		if self._closing then return end
		tab:Select()
	end)

	tab._button = btn
	tab._overlay = overlay

	-- Content holder for tab
	local page = new("ScrollingFrame", {
		Name = tab.Name .. "Page",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.fromOffset(0, 0),
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.Outline,
		Visible = false,
	})
	page.Parent = self._content
	pad(page, 10, 10, 10, 10)

	local layout = new("UIListLayout", {
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	layout.Parent = page
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		page.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 6)
	end)

	tab._page = page

	table.insert(self.Tabs, tab)
	if not self._selectedTab then
		tab:Select()
	end
	return tab
end

function Window:_selectTab(tab)
	if self._selectedTab == tab then return end
	local prev = self._selectedTab
	self._selectedTab = tab

	-- show page
	for _, t in ipairs(self.Tabs) do
		(t._page :: ScrollingFrame).Visible = false
	end
	(tab._page :: ScrollingFrame).Visible = true

	-- animate buttons: selected expands and stays dark
	local function setSelected(t, selected: boolean)
		t._selected = selected
		local btn = t._button :: TextButton
		local overlay = t._overlay :: Frame

		if selected then
			overlay.Size = UDim2.fromScale(1, 1)
			overlay.Position = UDim2.fromScale(0, 0)
			Anim.tween(btn, 0.18, {
				Size = UDim2.fromOffset(Visual.TabSelectedW, Visual.TabH),
				Position = UDim2.fromOffset(0, btn.Position.Y.Offset),
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		else
			Anim.tween(btn, 0.18, {
				Size = UDim2.fromOffset(Visual.TabNormalW, Visual.TabH),
				Position = UDim2.fromOffset(0, btn.Position.Y.Offset),
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			Anim.tween(overlay, 0.14, { Size = UDim2.fromScale(0, 1), Position = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end

	if prev then
		setSelected(prev, false)
	end
	setSelected(tab, true)
end

