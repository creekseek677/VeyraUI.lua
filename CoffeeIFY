--// Utility
local function clamp(n: number, a: number, b: number): number
	if n < a then return a end
	if n > b then return b end
	return n
end

local function roundToIncrement(n: number, inc: number?): number
	if not inc or inc <= 0 then
		return n
	end
	return math.floor((n / inc) + 0.5) * inc
end

local function deepCopy(t)
	local nt = {}
	for k, v in pairs(t) do
		if type(v) == "table" then
			nt[k] = deepCopy(v)
		else
			nt[k] = v
		end
	end
	return nt
end

local function safeCallback(cb, ...)
	if type(cb) == "function" then
		local ok, err = pcall(cb, ...)
		if not ok then
			warn("CoffeeIFY callback error:", err)
		end
	end
end

