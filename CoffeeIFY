--// Animation system
local Anim = {}
Anim.Easing = Enum.EasingStyle.Quad
Anim.DirOut = Enum.EasingDirection.Out
Anim.DirIn = Enum.EasingDirection.In

function Anim.tween(obj: Instance, time: number, props: {[string]: any}, easingStyle, easingDirection)
	local ti = TweenInfo.new(time, easingStyle or Anim.Easing, easingDirection or Anim.DirOut)
	local tw = TweenService:Create(obj, ti, props)
	tw:Play()
	return tw
end

function Anim.springy(obj: Instance, time: number, props: {[string]: any})
	local ti = TweenInfo.new(time, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local tw = TweenService:Create(obj, ti, props)
	tw:Play()
	return tw
end

-- Dark invasion hover: overlay grows from left.
function Anim.bindHoverInvasion(button: GuiObject, overlay: Frame, options)
	options = options or {}
	local enterSize = options.enterSize or UDim2.fromScale(1, 1)
	local leaveSize = options.leaveSize or UDim2.fromScale(0, 1)
	local enterPos = options.enterPos or UDim2.fromScale(0, 0)
	local leavePos = options.leavePos or UDim2.fromScale(0, 0)
	local t = options.time or 0.14

	overlay.Size = leaveSize
	overlay.Position = leavePos
	overlay.BackgroundTransparency = options.transparency or 0

	local hovering = false
	button.MouseEnter:Connect(function()
		hovering = true
		Anim.tween(overlay, t, { Size = enterSize, Position = enterPos }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		Anim.tween(overlay, t, { Size = leaveSize, Position = leavePos }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end)

	-- touch support
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			Anim.tween(overlay, t, { Size = enterSize, Position = enterPos }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			Anim.tween(overlay, t, { Size = leaveSize, Position = leavePos }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end)

	return function(forceOff: boolean?)
		if forceOff then
			overlay.Size = leaveSize
			overlay.Position = leavePos
		end
	end
end

function Anim.bindPress(button: GuiButton, target: GuiObject?, options)
	options = options or {}
	local down = options.down or 0.02
	local t = options.time or 0.08
	local oSize = (target or button).Size
	local oPos = (target or button).Position

	button.MouseButton1Down:Connect(function()
		Anim.tween(target or button, t, {
			Size = UDim2.new(oSize.X.Scale, oSize.X.Offset - (oSize.X.Offset * down), oSize.Y.Scale, oSize.Y.Offset - (oSize.Y.Offset * down)),
			Position = UDim2.new(oPos.X.Scale, oPos.X.Offset + 1, oPos.Y.Scale, oPos.Y.Offset + 1),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end)
	button.MouseButton1Up:Connect(function()
		Anim.tween(target or button, t, { Size = oSize, Position = oPos }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end)
	button.MouseLeave:Connect(function()
		Anim.tween(target or button, t, { Size = oSize, Position = oPos }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end)
end

--// Icons (lucide.lua)
local Icons = { Library = nil }

function Icons.get(name: string)
	-- Soft dependency on lucide.lua. This supports the common ways users expose it:
	-- CoffeeIFY:SetIconLibrary(lucide), _G.lucide, shared.lucide, or replicated ModuleScript named "lucide"/"Lucide".
	local candidates = {}
	local function addCandidate(v)
		if v ~= nil then
			table.insert(candidates, v)
		end
	end
	addCandidate(Icons.Library)
	pcall(function() addCandidate((_G :: any).lucide or (_G :: any).Lucide) end)
	pcall(function() addCandidate((shared :: any).lucide or (shared :: any).Lucide) end)
	pcall(function()
		local rs = game:GetService("ReplicatedStorage")
		local mod = rs:FindFirstChild("lucide") or rs:FindFirstChild("Lucide") or rs:FindFirstChild("lucide.lua")
		if mod and mod:IsA("ModuleScript") then
			addCandidate(require(mod))
		end
	end)

	for _, lucide in ipairs(candidates) do
		if type(lucide) == "table" then
			local entry = lucide[name] or lucide[string.lower(name)]
			if type(entry) == "function" then
				return entry
			elseif type(entry) == "string" then
				return function() return entry end
			elseif type(entry) == "table" then
				return function()
					return entry.Image or entry.image or entry.Asset or entry.asset or entry.Id or entry.id or ""
				end
			end
		end
	end

	-- Fallback: caller will render a tiny text glyph if no lucide source exists.
	return nil
end

--// UI factory helpers
local function new(inst: string, props)
	local obj = Instance.new(inst)
	for k, v in pairs(props or {}) do
		(obj :: any)[k] = v
	end
	return obj
end

local function applyStroke(frame: GuiObject, thickness: number)
	local stroke = new("UIStroke", {
		Thickness = thickness,
		Color = Theme.Outline,
		Transparency = 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
	stroke.Parent = frame
	return stroke
end

local function applyCorner(frame: GuiObject, radius: number)
	local corner = new("UICorner", { CornerRadius = UDim.new(0, radius) })
	corner.Parent = frame
	return corner
end

local function pad(frame: GuiObject, l, r, t, b)
	local p = new("UIPadding", {
		PaddingLeft = UDim.new(0, l),
		PaddingRight = UDim.new(0, r),
		PaddingTop = UDim.new(0, t),
		PaddingBottom = UDim.new(0, b),
	})
	p.Parent = frame
	return p
end

