	})

	local SIDEBAR_W = 136

	self.sidebar = Create("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, SIDEBAR_W, 1, -32),
		Position = UDim2.new(0, 2, 0, 30),
		BackgroundColor3 = THEME.Sidebar,
		BorderSizePixel = 0,
		Parent = self.main
	})


	self.content = Create("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -140, 1, -32),
		Position = UDim2.new(0, 138, 0, 30),
		BackgroundColor3 = THEME.Panel,
		BorderSizePixel = 0,
		Parent = self.main
	})

	self.contentTitle = Create("TextLabel", {
		Name = "Title",
		Text = "TAB 1",
		Size = UDim2.new(1, -16, 0, 28),
		Position = UDim2.new(0, 12, 0, 6),
		BackgroundTransparency = 1,
		TextColor3 = THEME.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = self.content
	})

	self.pages = Create("Folder", {
		Name = "Pages",
		Parent = self.content
	})

	self.tabs = {}
	self.tabButtons = {}
	self.currentTab = nil
	self.tabCount = 0

	local minimizedSize = UDim2.new(0, base, 0, 30)
	local normalSize = UDim2.new(0, base, 0, base)

	local function setMinimized(value)
		if self._closing then
			return
		end

		self._minimized = value

		if value then
			for _, child in ipairs(self.main:GetChildren()) do
				if child ~= self.topBar and child:IsA("GuiObject") then
					Tween(child, {
						BackgroundTransparency = 1
					}, 0.1)
				end
			end

			Tween(self.main, {
				Size = minimizedSize
			}, 0.22, Enum.EasingStyle.Quad)

			task.delay(0.1, function()
				if self._minimized and not self._closing then
					for _, child in ipairs(self.main:GetChildren()) do
						if child ~= self.topBar and child:IsA("GuiObject") then
							child.Visible = false
						end
					end
				end
			end)
		else
			for _, child in ipairs(self.main:GetChildren()) do
				if child ~= self.topBar and child:IsA("GuiObject") then
					child.Visible = true
				end
			end

			Tween(self.main, {
				Size = normalSize
			}, 0.3, Enum.EasingStyle.Quad)

			task.delay(0.05, function()
				if not self._minimized and not self._closing then
					Tween(self.sidebar, {BackgroundTransparency = 0}, 0.18)
					Tween(self.content, {BackgroundTransparency = 0}, 0.18)

					for _, child in ipairs(self.content:GetDescendants()) do
						if child:IsA("GuiObject") then
							if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
								local props = {}
								if child.TextTransparency < 1 then
									props.TextTransparency = 0
								end
								if next(props) then
									Tween(child, props, 0.18)
								end
							end
						end
					end
				end
			end)
		end
	end

	local spinActive = true
	self:_Track(RunService.RenderStepped:Connect(function(dt)
		if not spinActive or self._closing or not self.titleIcon or not self.titleIcon.Parent then
			return
		end
		self.titleIcon.Rotation = (self.titleIcon.Rotation + dt * 120) % 360
	end))

	self:_Track(minBtn.MouseEnter:Connect(function()
		if self._closing then return end
		PlaySound(HOVER_SOUND, 0.2)
		Tween(minBtn, {TextColor3 = Color3.fromRGB(255, 255, 255)}, 0.15)
	end))

	self:_Track(minBtn.MouseLeave:Connect(function()
		if self._closing then return end
		Tween(minBtn, {TextColor3 = Color3.fromRGB(194, 185, 166)}, 0.15)
	end))

	self:_Track(closeBtn.MouseEnter:Connect(function()
		if self._closing then return end
		PlaySound(HOVER_SOUND, 0.2)
		Tween(closeBtn, {TextColor3 = Color3.fromRGB(255, 120, 120)}, 0.15)
	end))

	self:_Track(closeBtn.MouseLeave:Connect(function()
		if self._closing then return end
		Tween(closeBtn, {TextColor3 = Color3.fromRGB(194, 185, 166)}, 0.15)
	end))

	self:_Track(BindActivated(minBtn, function()
		if self._closing then return end
		PlaySound(CLICK_SOUND, 0.4)
		setMinimized(not self._minimized)
	end))

	local function doClose()
		if self._closing then
			return
		end

		self._closing = true
		spinActive = false
		PlaySound(CLICK_SOUND, 0.45)

		local layer = Create("Frame", {
			Name = "GlitchDisassemble",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 90,
			Parent = self.main
		})

		local chunks = {}
		local count = math.clamp(math.floor(base / 24), 14, 22)
		local bandH = base / count

		for i = 1, count do
			local y = (i - 1) * bandH
			local jitter = math.random(-8, 8)
			local chunk = Create("Frame", {
				Name = "Chunk" .. i,
				Size = UDim2.new(0, base + 18, 0, math.ceil(bandH + 2)),
				Position = UDim2.new(0, -9 + jitter, 0, y),
				BackgroundColor3 = Color3.fromRGB(47, 44, 40),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 91,
				Parent = layer
			})
			chunks[i] = chunk
		end

		-- Black glitch assembles over the UI first. Tiny stagger keeps it quiet rather than explosive.
		for i, chunk in ipairs(chunks) do
			Tween(chunk, {BackgroundTransparency = 0.04}, 0.08 + i * 0.012, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end

		-- The actual interface disappears underneath the forming glitch.
		for _, obj in ipairs(self.main:GetDescendants()) do
			if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
				Tween(obj, {TextTransparency = 1}, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			elseif obj:IsA("GuiObject") and obj ~= layer and not obj:IsDescendantOf(layer) then
				Tween(obj, {BackgroundTransparency = 1}, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			end
		end

		task.wait(0.26)

		-- Pull the glitch pieces apart with small positional bursts.
		for i, chunk in ipairs(chunks) do
			local dir = (i % 2 == 0) and 1 or -1
			local x = dir * math.random(45, 105)
			local y = math.random(-10, 10)
			Tween(chunk, {
				Position = UDim2.new(0, (dir == -1 and -base or base) + x, 0, chunk.Position.Y.Offset + y),
				BackgroundTransparency = 1
			}, 0.28 + (i % 5) * 0.025, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		end

		task.wait(0.42)
		self:_CleanupConnections()
		if self.gui then
			self.gui:Destroy()
		end
	end

	self:_Track(BindActivated(closeBtn, doClose))

	local dragging = false
	local dragStart
	local startPos
	local dragInput

	self:_Track(self.topBar.InputBegan:Connect(function(input)
		if self._closing then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = input.Position
			startPos = self.main.Position
			dragInput = input
		end
	end))

	self:_Track(UserInputService.InputChanged:Connect(function(input)
		if not dragging or self._closing then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local delta = input.Position - dragStart

			self.main.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end))

	self:_Track(UserInputService.InputEnded:Connect(function(input)
		if input == dragInput
			or input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = false
			dragInput = nil
		end
	end))

	self:_Track(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		if self._closing then
			return
		end

		local newVp = cam.ViewportSize
		local newBase = math.clamp(math.min(newVp.X, newVp.Y) * 0.48, 340, 500)

		base = newBase
		normalSize = UDim2.new(0, newBase, 0, newBase)
		minimizedSize = UDim2.new(0, newBase, 0, 30)

		if self._minimized then
			self.main.Size = minimizedSize
		else
			self.main.Size = normalSize
		end
	end))

	task.spawn(function()
		local dots = 0

		while intro.Parent and not self._closing do
			dots = (dots % 3) + 1
			loadingText.Text = "loading" .. string.rep(".", dots)
			task.wait(0.3)
		end
	end)

	task.spawn(function()
		task.wait(0.4)

		for i, p in ipairs(pieces) do
			if not p.Parent then
				return
			end

			Tween(p, {
				Position = UDim2.new(
					0.5,
					-40 + (i % 4) * 22,
					0.5,
					-110 + math.floor((i - 1) / 4) * 22  -- raised so it sits above the CoffeeIFY label
				),
				BackgroundTransparency = 0.15
			}, 0.55 + i * 0.04, Enum.EasingStyle.Back)
		end

		task.wait(0.85)

		for _, p in ipairs(pieces) do
			if p.Parent then
				Tween(p, {
					BackgroundTransparency = 0,
					Size = UDim2.new(0, 22, 0, 22)
				}, 0.25)
			end
		end

		task.wait(0.35)

		Tween(introTitle, {TextTransparency = 1}, 0.4)
		Tween(loadingText, {TextTransparency = 1}, 0.4)

		for _, p in ipairs(pieces) do
			Tween(p, {BackgroundTransparency = 1}, 0.4)
		end

		Tween(intro, {BackgroundTransparency = 1}, 0.5)

		task.wait(0.55)

		if intro.Parent then
			intro:Destroy()
		end

		if self._closing or not self.main then
			return
		end

		-- ========== GLITCH ASSEMBLE ==========
		self.main.Visible = true
		self.main.BackgroundTransparency = 0

		local layer = Create("Frame", {
			Name = "GlitchAssemble",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 90,
			Parent = self.main
		})

		-- Start with the UI hidden behind a quiet black glitch mask.
		local fadeTargets = {self.topBar, self.sidebar, self.content}
		for _, obj in ipairs(fadeTargets) do
			obj.BackgroundTransparency = 1
		end
		for _, obj in ipairs(self.content:GetDescendants()) do
			if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
				obj.TextTransparency = 1
			elseif obj:IsA("GuiObject") then
				obj.BackgroundTransparency = 1
			end
		end

		local chunks = {}
		local count = math.clamp(math.floor(base / 24), 14, 22)
		local bandH = base / count

		for i = 1, count do
			local y = (i - 1) * bandH
			local jitter = math.random(-14, 14)
			local chunk = Create("Frame", {
				Name = "Chunk" .. i,
				Size = UDim2.new(0, base + 20, 0, math.ceil(bandH + 2)),
				Position = UDim2.new(0, -10 + jitter, 0, y),
				BackgroundColor3 = Color3.fromRGB(47, 44, 40),
				BackgroundTransparency = 0.12,
				BorderSizePixel = 0,
				ZIndex = 91,
				Parent = layer
			})
			chunks[i] = chunk
		end

		-- The chunks subtly snap toward the UI's exact proportions.
		for i, chunk in ipairs(chunks) do
			local targetX = -10 + math.random(-2, 2)
			Tween(chunk, {
				Position = UDim2.new(0, targetX, 0, (i - 1) * bandH),
				BackgroundTransparency = 0.02
			}, 0.18 + i * 0.012, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		end

		-- At the same time, the UI quietly fades into place.
		for index, obj in ipairs(fadeTargets) do
			Tween(obj, {BackgroundTransparency = 0}, 0.24 + index * 0.02, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
		for _, obj in ipairs(self.content:GetDescendants()) do
			if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
				Tween(obj, {TextTransparency = 0}, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			end
		end

		task.wait(0.3)

		-- Small glitch flicker, then the mask disappears.
		for i, chunk in ipairs(chunks) do
			local flicker = (i % 2 == 0) and 0.16 or 0.06
			Tween(chunk, {BackgroundTransparency = flicker}, 0.05)
		end
		task.wait(0.06)
		for _, chunk in ipairs(chunks) do
			Tween(chunk, {BackgroundTransparency = 1}, 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
		task.wait(0.14)
		if layer.Parent then
			layer:Destroy()
		end

		task.delay(0.18, function()
			if not self._closing and self.gui and self.gui.Parent then
				self:Notify("CoffeeIFY loaded", 2.2)
			end
		end)

	end)

	return self
end

function CoffeeIFY:CreateTab(name)
	if self._closing then
		return
	end

	if self.tabs[name] then
		warn(("CoffeeIFY: tab '%s' already exists."):format(name))
		return self.tabs[name]
	end

	self.tabCount += 1
	local index = self.tabCount

	local TAB_H = 25
	local TAB_GAP = 34
	local TAB_X = 0

	local btn = Create("TextButton", {
		Name = name,
		Size = UDim2.new(1, -16, 0, TAB_H),
		Position = UDim2.new(0, TAB_X, 0, 10 + (index - 1) * TAB_GAP),
		BackgroundColor3 = THEME.Row,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = self.sidebar
	})

	local icon = Create("Frame", {
		Size = UDim2.new(0, 8, 0, 8),
		Position = UDim2.new(0, 9, 0.5, -4),
		BackgroundColor3 = Color3.fromRGB(72, 65, 57),
		BorderSizePixel = 0,
		Parent = btn
	})

	local label = Create("TextLabel", {
		Text = name,
		Size = UDim2.new(1, -30, 1, 0),
		Position = UDim2.new(0, 24, 0, 0),
		BackgroundTransparency = 1,
		TextColor3 = THEME.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = btn
	})

	local hover = AddHoverSweep(btn, btn, {icon, label}, THEME.Row, THEME.RowHover)

	local page = Create("ScrollingFrame", {
		Name = name,
		Size = UDim2.new(1, -20, 1, -44),
		Position = UDim2.new(0, 10, 0, 36),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Color3.fromRGB(145, 135, 115),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = self.pages
	})

	Create("UIListLayout", {
		Padding = UDim.new(0, 7),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = page
	})

	Create("UIPadding", {
		PaddingTop = UDim.new(0, 2),
		PaddingBottom = UDim.new(0, 8),
		Parent = page
	})

	local tabData = {
		Button = btn,
		Icon = icon,
		Label = label,
		Page = page,
		Name = name,
		Hover = hover
	}

	self.tabs[name] = tabData
	self.tabButtons[index] = tabData

	local function glitchTypewriter(targetText)
		if not self.contentTitle or not self.contentTitle.Parent then return end

		local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%&*"
		local final = targetText
		local len = #final

		task.spawn(function()
			for i = 1, 7 do
				if not self.contentTitle or not self.contentTitle.Parent then return end
				local glitched = ""
				for j = 1, len do
					if math.random() > 0.35 then
						local r = math.random(1, #chars)
						glitched = glitched .. chars:sub(r, r)
					else
						glitched = glitched .. final:sub(j, j)
					end
				end
				self.contentTitle.Text = glitched
				task.wait(0.025)
			end

			self.contentTitle.Text = ""
			for i = 1, len do
				if not self.contentTitle or not self.contentTitle.Parent then return end
				self.contentTitle.Text = final:sub(1, i)
				task.wait(0.03)
			end
			self.contentTitle.Text = final
		end)
	end

	local function select()
		if self._closing then return end
		PlaySound(CLICK_SOUND, 0.35)

		for i, t in pairs(self.tabButtons) do
			if t ~= tabData then
				Tween(t.Button, {BackgroundColor3 = THEME.Row}, 0.16)
				Tween(t.Label, {TextColor3 = THEME.Text}, 0.16)
				Tween(t.Icon, {BackgroundColor3 = Color3.fromRGB(72, 65, 57)}, 0.16)
				t.Hover:SetLocked(false)
				t.Page.Visible = false
			end
		end

		Tween(btn, {BackgroundColor3 = THEME.Dark}, 0.16)
		Tween(label, {TextColor3 = THEME.TextLight}, 0.16)
		Tween(icon, {BackgroundColor3 = THEME.TextLight}, 0.16)
		hover:SetLocked(true)

		page.Visible = true
		self.currentTab = tabData
		glitchTypewriter(name)
	end

	self:_Track(btn.MouseEnter:Connect(function()
		if self._closing then return end
		PlaySound(HOVER_SOUND, 0.16)
	end))

	self:_Track(BindActivated(btn, select))

	if index == 1 then
		select()
	end

	return tabData
end

