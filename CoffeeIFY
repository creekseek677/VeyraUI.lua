			Default = math.floor((default :: Color3)[channel] * 255 + 0.5),
			Increment = 1,
			Callback = function(v)
				local r = math.floor((comp.Value.R * 255) + 0.5)
				local g = math.floor((comp.Value.G * 255) + 0.5)
				local b = math.floor((comp.Value.B * 255) + 0.5)
				if channel == "R" then r = v end
				if channel == "G" then g = v end
				if channel == "B" then b = v end
				setColor(Color3.fromRGB(r, g, b), true)
			end,
		})
		-- reparent slider root into body
		(s._root :: Instance).Parent = body
		return s
	end

	local sr = makeRGB("Red", "R")
	local sg = makeRGB("Green", "G")
	local sb = makeRGB("Blue", "B")

