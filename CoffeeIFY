		BackgroundColor3 = Color3.fromRGB(232, 224, 205),
		BorderSizePixel = 0,
		ZIndex = 100,
		Parent = self.gui
	})

	local introTitle = Create("TextLabel", {
		Text = "CoffeeIFY",
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.new(0, 0, 0.42, 0),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(50, 45, 40),
		Font = Enum.Font.GothamBold,
		TextSize = 28,
		Parent = intro
	})

	local loadingText = Create("TextLabel", {
		Name = "LoadingText",
		Text = "loading",
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.new(0, 0, 0.5, 10),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(90, 80, 70),
		Font = Enum.Font.Gotham,
		TextSize = 14,
		Parent = intro
	})

	local pieces = {}

	for i = 1, 8 do
		local p = Create("Frame", {
			Size = UDim2.new(0, 18, 0, 18),
			Position = UDim2.new(0.5, math.random(-220, 220), 0.5, math.random(-160, 160)),
			BackgroundColor3 = Color3.fromRGB(60, 55, 50),
			BorderSizePixel = 0,
			BackgroundTransparency = 0.4,
			Parent = intro
		})

		pieces[i] = p
	end

	local cam = workspace.CurrentCamera
	local vp = cam.ViewportSize
	local base = math.clamp(math.min(vp.X, vp.Y) * 0.42, 300, 420)

	self.main = Create("Frame", {
		Name = "Main",
		Size = UDim2.new(0, base, 0, base),
		Position = UDim2.new(0.5, -base / 2, 0.5, -base / 2),
		BackgroundColor3 = Color3.fromRGB(232, 224, 205),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		Parent = self.gui
	})

	Create("UIStroke", {
		Color = Color3.fromRGB(170, 160, 140),
		Thickness = 1.5,
		Parent = self.main
	})

	self.topBar = Create("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundColor3 = Color3.fromRGB(42, 38, 34),
		BorderSizePixel = 0,
		Parent = self.main
	})

	self.titleIcon = Create("TextLabel", {
		Text = "◆",
		Size = UDim2.new(0, 18, 1, 0),
		Position = UDim2.new(0, 8, 0, 0),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(225, 215, 195),
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		Parent = self.topBar
	})

	self.title = Create("TextLabel", {
		Text = "CoffeeIFY",
		Size = UDim2.new(1, -90, 1, 0),
		Position = UDim2.new(0, 28, 0, 0),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(225, 215, 195),
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = self.topBar
	})

	local minBtn = Create("TextButton", {
		Name = "Minimize",
		Size = UDim2.new(0, 28, 0, 28),
		Position = UDim2.new(1, -56, 0, 0),
		BackgroundTransparency = 1,
		Text = "–",
		TextColor3 = Color3.fromRGB(200, 190, 170),
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		AutoButtonColor = false,
		Parent = self.topBar
	})

	local closeBtn = Create("TextButton", {
		Name = "Close",
		Size = UDim2.new(0, 28, 0, 28),
		Position = UDim2.new(1, -28, 0, 0),
		BackgroundTransparency = 1,
		Text = "×",
		TextColor3 = Color3.fromRGB(200, 190, 170),
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		AutoButtonColor = false,
		Parent = self.topBar
	})

	self.sidebar = Create("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, 98, 1, -28),
		Position = UDim2.new(0, 0, 0, 28),
		BackgroundColor3 = Color3.fromRGB(205, 195, 175),
		BorderSizePixel = 0,
		Parent = self.main
	})

	Create("UIStroke", {
		Color = Color3.fromRGB(170, 160, 140),
		Thickness = 1,
		Parent = self.sidebar
	})

	self.content = Create("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -98, 1, -28),
		Position = UDim2.new(0, 98, 0, 28),
		BackgroundColor3 = Color3.fromRGB(232, 224, 205),
		BorderSizePixel = 0,
		Parent = self.main
	})

	self.contentTitle = Create("TextLabel", {
		Name = "Title",
		Text = "TAB 1",
		Size = UDim2.new(1, -16, 0, 28),
		Position = UDim2.new(0, 12, 0, 6),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(35, 30, 25),
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = self.content
	})

	self.pages = Create("Folder", {
		Name = "Pages",
		Parent = self.content
	})

	self.tabs = {}
	self.tabButtons = {}
	self.currentTab = nil
	self.tabCount = 0

	local minimizedSize = UDim2.new(0, base, 0, 28)
	local normalSize = UDim2.new(0, base, 0, base)

	local function setMinimized(value)
		if self._closing then
			return
		end

		self._minimized = value

		if value then
			for _, child in ipairs(self.main:GetChildren()) do
				if child ~= self.topBar and child:IsA("GuiObject") then
					Tween(child, {
						BackgroundTransparency = 1
					}, 0.18)
				end
			end

			Tween(self.main, {
				Size = minimizedSize
			}, 0.3, Enum.EasingStyle.Quad)

			task.delay(0.22, function()
				if self._minimized and not self._closing then
					for _, child in ipairs(self.main:GetChildren()) do
						if child ~= self.topBar and child:IsA("GuiObject") then
							child.Visible = false
						end
					end
				end
			end)
		else
			for _, child in ipairs(self.main:GetChildren()) do
				if child ~= self.topBar and child:IsA("GuiObject") then
					child.Visible = true
				end
			end

			Tween(self.main, {
				Size = normalSize
			}, 0.3, Enum.EasingStyle.Quad)

			task.delay(0.05, function()
				if not self._minimized and not self._closing then
					Tween(self.sidebar, {BackgroundTransparency = 0}, 0.18)
					Tween(self.content, {BackgroundTransparency = 0}, 0.18)

					for _, child in ipairs(self.content:GetDescendants()) do
						if child:IsA("GuiObject") then
							if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
								local props = {}
								if child.TextTransparency < 1 then
									props.TextTransparency = 0
								end
								if next(props) then
									Tween(child, props, 0.18)
								end
							end
						end
					end
				end
			end)
		end
	end

	local spinActive = true
	self:_Track(RunService.RenderStepped:Connect(function(dt)
		if not spinActive or self._closing or not self.titleIcon or not self.titleIcon.Parent then
			return
		end
		self.titleIcon.Rotation = (self.titleIcon.Rotation + dt * 120) % 360
	end))

	self:_Track(minBtn.MouseEnter:Connect(function()
		if self._closing then return end
		PlaySound(HOVER_SOUND, 0.2)
		Tween(minBtn, {TextColor3 = Color3.fromRGB(255, 255, 255)}, 0.15)
	end))

	self:_Track(minBtn.MouseLeave:Connect(function()
		if self._closing then return end
		Tween(minBtn, {TextColor3 = Color3.fromRGB(200, 190, 170)}, 0.15)
	end))

	self:_Track(closeBtn.MouseEnter:Connect(function()
		if self._closing then return end
		PlaySound(HOVER_SOUND, 0.2)
		Tween(closeBtn, {TextColor3 = Color3.fromRGB(255, 120, 120)}, 0.15)
	end))

	self:_Track(closeBtn.MouseLeave:Connect(function()
		if self._closing then return end
		Tween(closeBtn, {TextColor3 = Color3.fromRGB(200, 190, 170)}, 0.15)
	end))

	self:_Track(BindActivated(minBtn, function()
		if self._closing then return end
		PlaySound(CLICK_SOUND, 0.4)
		setMinimized(not self._minimized)
	end))

	local function doClose()
		if self._closing then
			return
		end

		self._closing = true
		spinActive = false
		PlaySound(CLICK_SOUND, 0.45)

		for _, child in ipairs(self.main:GetDescendants()) do
			if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
				Tween(child, {TextTransparency = 1}, 0.25)
			elseif child:IsA("GuiObject") and child ~= self.main then
				Tween(child, {BackgroundTransparency = 1}, 0.28)
			end
		end

		Tween(self.main, {
			BackgroundColor3 = Color3.fromRGB(232, 224, 205)
		}, 0.2)

		task.wait(0.18)

		local originalPosition = self.main.Position

		Tween(self.main, {
			Size = UDim2.new(0, base * 0.78, 0, base * 0.78),
			Position = UDim2.new(
				originalPosition.X.Scale,
				originalPosition.X.Offset + base * 0.11,
				originalPosition.Y.Scale,
				originalPosition.Y.Offset + base * 0.11
			)
		}, 0.32, Enum.EasingStyle.Back, Enum.EasingDirection.InOut)

		task.wait(0.2)

		local fragments = {}

		for i = 1, 8 do
			local fragment = Create("Frame", {
				Name = "DisassemblyPiece" .. i,
				Size = UDim2.new(0, math.max(8, base * 0.06), 0, math.max(8, base * 0.06)),
				Position = UDim2.new(
					0.5,
					math.cos(i / 8 * math.pi * 2) * base * 0.15,
					0.5,
					math.sin(i / 8 * math.pi * 2) * base * 0.15
				),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = Color3.fromRGB(232, 224, 205),
				BorderSizePixel = 0,
				ZIndex = 200,
				Parent = self.gui
			})

			fragments[i] = fragment
		end

		self.main.Visible = false

		for i, fragment in ipairs(fragments) do
			local angle = (i / #fragments) * math.pi * 2
			local distance = base * (0.25 + i * 0.025)

			Tween(fragment, {
				Position = UDim2.new(
					0.5,
					math.cos(angle) * distance,
					0.5,
					math.sin(angle) * distance
				),
				Rotation = math.random(-180, 180),
				BackgroundTransparency = 1,
				Size = UDim2.new(0, 2, 0, 2)
			}, 0.42 + i * 0.025, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end

		task.wait(0.55)

		for _, fragment in ipairs(fragments) do
			if fragment and fragment.Parent then
				fragment:Destroy()
			end
		end

		self:_CleanupConnections()

		if self.gui then
			self.gui:Destroy()
		end
	end

	self:_Track(BindActivated(closeBtn, doClose))

	local dragging = false
	local dragStart
	local startPos
	local dragInput

	self:_Track(self.topBar.InputBegan:Connect(function(input)
		if self._closing then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = input.Position
			startPos = self.main.Position
			dragInput = input
		end
	end))

	self:_Track(UserInputService.InputChanged:Connect(function(input)
		if not dragging or self._closing then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local delta = input.Position - dragStart

			self.main.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end))

	self:_Track(UserInputService.InputEnded:Connect(function(input)
		if input == dragInput
			or input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = false
			dragInput = nil
		end
	end))

	self:_Track(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		if self._closing then
			return
		end

		local newVp = cam.ViewportSize
		local newBase = math.clamp(math.min(newVp.X, newVp.Y) * 0.42, 300, 420)

		base = newBase
		normalSize = UDim2.new(0, newBase, 0, newBase)
		minimizedSize = UDim2.new(0, newBase, 0, 28)

		if self._minimized then
			self.main.Size = minimizedSize
		else
			self.main.Size = normalSize
		end
	end))

	task.spawn(function()
		local dots = 0

		while intro.Parent and not self._closing do
			dots = (dots % 3) + 1
			loadingText.Text = "loading" .. string.rep(".", dots)
			task.wait(0.3)
		end
	end)

	task.spawn(function()
		task.wait(0.4)

		for i, p in ipairs(pieces) do
			if not p.Parent then
				return
			end

			Tween(p, {
				Position = UDim2.new(
					0.5,
					-40 + (i % 4) * 22,
					0.5,
					-30 + math.floor((i - 1) / 4) * 22
				),
				BackgroundTransparency = 0.15
			}, 0.55 + i * 0.04, Enum.EasingStyle.Back)
		end

		task.wait(0.85)

		for _, p in ipairs(pieces) do
			if p.Parent then
				Tween(p, {
					BackgroundTransparency = 0,
					Size = UDim2.new(0, 22, 0, 22)
				}, 0.25)
			end
		end

		task.wait(0.35)

		Tween(introTitle, {TextTransparency = 1}, 0.4)
		Tween(loadingText, {TextTransparency = 1}, 0.4)

		for _, p in ipairs(pieces) do
			Tween(p, {BackgroundTransparency = 1}, 0.4)
		end

		Tween(intro, {BackgroundTransparency = 1}, 0.5)

		task.wait(0.55)

		if intro.Parent then
			intro:Destroy()
		end

		if not self._closing and self.main then
			self.main.Visible = true
			Tween(self.main, {BackgroundTransparency = 0}, 0.35)
		end
	end)

	return self
end

function CoffeeIFY:CreateTab(name)
	if self._closing then
		return
	end

	if self.tabs[name] then
		warn(("CoffeeIFY: tab '%s' already exists."):format(name))
		return self.tabs[name]
	end

	self.tabCount += 1
	local index = self.tabCount

	local btn = Create("TextButton", {
		Name = name,
		Size = UDim2.new(1, -10, 0, 26),
		Position = UDim2.new(0, 5, 0, 6 + (index - 1) * 30),
		BackgroundColor3 = Color3.fromRGB(185, 175, 155),
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = self.sidebar
	})

	local icon = Create("Frame", {
		Size = UDim2.new(0, 7, 0, 7),
		Position = UDim2.new(0, 7, 0.5, -3.5),
		BackgroundColor3 = Color3.fromRGB(70, 60, 50),
		BorderSizePixel = 0,
		Parent = btn
	})

	local label = Create("TextLabel", {
		Text = name,
		Size = UDim2.new(1, -22, 1, 0),
		Position = UDim2.new(0, 18, 0, 0),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(45, 40, 35),
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = btn
	})

	local page = Create("ScrollingFrame", {
		Name = name,
		Size = UDim2.new(1, -16, 1, -42),
		Position = UDim2.new(0, 8, 0, 36),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Color3.fromRGB(140, 130, 110),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = self.pages
	})

	Create("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = page
	})

	Create("UIPadding", {
		PaddingTop = UDim.new(0, 2),
		PaddingBottom = UDim.new(0, 6),
		Parent = page
	})

	local tabData = {
		Button = btn,
		Icon = icon,
		Label = label,
		Page = page,
		Name = name
	}

	self.tabs[name] = tabData
	self.tabButtons[index] = tabData

	local function select()
		if self._closing then
			return
		end

		PlaySound(CLICK_SOUND, 0.35)

		for _, t in pairs(self.tabs) do
			Tween(t.Button, {BackgroundColor3 = Color3.fromRGB(185, 175, 155)}, 0.2)
			Tween(t.Label, {TextColor3 = Color3.fromRGB(45, 40, 35)}, 0.2)
			Tween(t.Icon, {BackgroundColor3 = Color3.fromRGB(70, 60, 50)}, 0.2)
			t.Page.Visible = false
		end

		Tween(btn, {BackgroundColor3 = Color3.fromRGB(48, 43, 38)}, 0.22)
		Tween(label, {TextColor3 = Color3.fromRGB(230, 220, 200)}, 0.22)
		Tween(icon, {BackgroundColor3 = Color3.fromRGB(230, 220, 200)}, 0.22)

		page.Visible = true
		self.contentTitle.Text = name
		self.currentTab = tabData
	end

	self:_Track(btn.MouseEnter:Connect(function()
		if self._closing then return end
		PlaySound(HOVER_SOUND, 0.18)

		if self.currentTab ~= tabData then
			Tween(btn, {BackgroundColor3 = Color3.fromRGB(200, 190, 170)}, 0.15)
		end
	end))

	self:_Track(btn.MouseLeave:Connect(function()
		if self._closing then return end

		if self.currentTab ~= tabData then
			Tween(btn, {BackgroundColor3 = Color3.fromRGB(185, 175, 155)}, 0.15)
		end
	end))

	self:_Track(BindActivated(btn, select))

	if index == 1 then
		select()
	end

	return tabData
end

function CoffeeIFY:CreateButton(tab, text, callback)
	local page = self:_GetPage(tab)
	text = tostring(text or "Button")

	local pageWidth = GetPageWidth(page, 260)
	local naturalWidth = MeasureText(text, Enum.Font.Gotham, 12, 10000)
	local labelWidth = math.max(math.min(math.max(naturalWidth + 6, 80), pageWidth - 36), 70)
	local _, textHeight = MeasureText(text, Enum.Font.Gotham, 12, labelWidth - 4)
	local rowHeight = math.max(26, textHeight + 10)

	local frame = Create("Frame", {
		Size = UDim2.new(1, -12, 0, rowHeight),
		Position = UDim2.new(0, 6, 0, 0),
		BackgroundColor3 = Color3.fromRGB(218, 208, 188),
		BorderSizePixel = 0,
		Parent = page
	})

	local box = Create("Frame", {
		Size = UDim2.new(0, 12, 0, 12),
		Position = UDim2.new(0, 14, 0.5, -6),
		BackgroundColor3 = Color3.fromRGB(40, 35, 30),
		BorderSizePixel = 0,
		Parent = frame
	})

	local label = Create("TextLabel", {
		Text = text,
		Size = UDim2.new(1, -72, 0, math.max(18, rowHeight - 4)),
		Position = UDim2.new(0, 32, 0, 2),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(40, 35, 30),
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextWrapped = true,
