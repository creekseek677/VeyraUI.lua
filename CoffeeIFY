		setOpen(not open)
	end)

	comp._root = root
	comp.SetValue = function(_, v)
		if typeof(v) == "Color3" then
			setColor(v, false)
		end
	end

	table.insert(self.Components, comp)
	return comp
end

-- Keybind
function Section:CreateKeybind(opts)
	opts = opts or {}
	local default = opts.Default
	if typeof(default) ~= "EnumItem" then
		default = Enum.KeyCode.RightShift
	end

	local comp = setmetatable({ Value = default }, ComponentBase)
	local capturing = false

	local root = new("TextButton", {
		Name = "Keybind",
		BackgroundColor3 = Theme.Control,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 28),
		AutoButtonColor = false,
		Text = "",
	})
	applyCorner(root, 3)
	applyStroke(root, 1)
	root.Parent = self._list

	local overlay = new("Frame", {
		Name = "Hover",
		BackgroundColor3 = Theme.Dark,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		ZIndex = root.ZIndex + 1,
	})
	applyCorner(overlay, 3)
	overlay.Parent = root

	local label = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = tostring(opts.Name or "Keybind"),
		Font = Visual.FontBold,
		TextSize = Visual.TextSize,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -120, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		ZIndex = root.ZIndex + 2,
	})
	label.Parent = root
	local labelDark = label:Clone()
	labelDark.TextColor3 = Theme.White
	labelDark.ZIndex = overlay.ZIndex + 2
	labelDark.Parent = overlay

	local keyLbl = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = tostring(default.Name),
		Font = Visual.FontBold,
		TextSize = Visual.TextSize,
		TextColor3 = Theme.MutedText,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(0, 110, 1, 0),
		Position = UDim2.new(1, -120, 0, 0),
		ZIndex = root.ZIndex + 2,
	})
	keyLbl.Parent = root
	local keyLblDark = keyLbl:Clone()
	keyLblDark.TextColor3 = Theme.White
	keyLblDark.ZIndex = overlay.ZIndex + 2
	keyLblDark.Parent = overlay

	Anim.bindHoverInvasion(root, overlay, { time = 0.14 })
	Anim.bindPress(root)

	local function setCapture(v: boolean)
		capturing = v
		if capturing then
			keyLbl.Text = "..."
			keyLblDark.Text = "..."
			-- make dark overlay stay slightly in
			Anim.tween(overlay, 0.12, { Size = UDim2.fromScale(0.35, 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		else
			keyLbl.Text = tostring((comp.Value :: any).Name)
			keyLblDark.Text = keyLbl.Text
			Anim.tween(overlay, 0.12, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end

	local function setKey(kc: Enum.KeyCode, fire: boolean)
		comp.Value = kc
		setCapture(false)
		if fire then
			safeCallback(opts.Callback, kc)
		end
	end

	root.MouseButton1Click:Connect(function()
		if self.Tab.Window._interactive == false then return end
		if Global.Capturing and Global.Capturing ~= comp then
			-- cancel previous capture
			Global.Capturing._setCapture(false)
		end
		Global.Capturing = comp
		comp._setCapture(true)
	end)

	comp._setCapture = setCapture

	-- global input handler (keybinds should work while minimized where appropriate)
	local conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

		if capturing and Global.Capturing == comp then
			if input.KeyCode == Enum.KeyCode.Escape then
				setCapture(false)
				Global.Capturing = nil
				return
			end
			if input.KeyCode ~= Enum.KeyCode.Unknown then
				setKey(input.KeyCode, false)
				Global.Capturing = nil
			end
			return
		end

		-- fire callback if pressed
		if input.KeyCode == comp.Value then
			if input.KeyCode == self.Tab.Window.ToggleKey then
				return
			end
			safeCallback(opts.Callback)
		end
	end)
	table.insert(self.Tab.Window._connections, conn)

	comp._root = root
	comp.SetValue = function(_, v)
		if typeof(v) == "EnumItem" then
			setKey(v, false)
		end
	end

	table.insert(self.Components, comp)
	return comp
end

