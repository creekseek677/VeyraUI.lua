                    BackgroundTransparency = 1, Size = UDim2.new(1, -70, 1, 0), Position = UDim2.new(0, 24, 0, 0),
                    Font = Enum.Font.SourceSans, Text = text, TextColor3 = C.TextDark, TextSize = 13,
